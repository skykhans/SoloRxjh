            "consumptions": {
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "reason": {
                    "const": "quest_delivery"
