        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs",
        "progress_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "quest_before": {
          "$ref": "urn:solorxjh:second-advancement-quest-state:v1",
          "properties": {
            "state": {
              "const": "in_progress"
            }
          }
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 31,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "urn:solorxjh:second-advancement-transition-event:v1#/$defs/material_input"
              },
              {
                "$ref": "urn:solorxjh:second-advancement-transition-event:v1#/$defs/recommendation_input"
              }
            ]
          }
        },
        "progress_before": {
          "$ref": "urn:solorxjh:character-progress:v1",
          "properties": {
            "completed_rank": {
              "const": 1
            },
            "route": {
              "const": "unselected"
            },
            "hp": {
              "minimum": 1
            },
            "total_xp": {
              "minimum": 6341000
            }
          }
        }
      }
    },
