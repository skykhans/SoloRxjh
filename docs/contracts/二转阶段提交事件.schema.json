          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quest_after": {
          "$ref": "urn:solorxjh:second-advancement-quest-state:v1"
        },
        "stack_flows": {
          "type": "array",
          "maxItems": 2,
