{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:training-ai-decision:v1",
  "$comment": "原世界固定步中的修炼活体AI已提交结果，严格前后六字段投影，不是完整actor/世界/独立日志。23合法状态事件格由原转换表限定；原before、after差异、stop根全集/规则/身份/路径与回血授权另验。生命周期移除由原槽结果，不进入本活体结果。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "source_actor_id",
    "world_step",
    "rules_hash",
    "event",
    "before",
    "after",
    "stopped_root_event_ids"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 76,
      "maxLength": 76,
      "pattern": "^training-ai:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:world-step-state:v1#/$defs/training_map_id"
    },
    "instance_id_or_null": {
      "type": "null"
    },
    "source_actor_id": {
      "type": "string",
      "minLength": 79,
      "maxLength": 79,
      "pattern": "^training-actor:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rules_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "event": {
      "enum": [
        "attack_admitted",
        "attack_rejected",
        "forced_return",
        "new_sensed_target",
        "normal_action_finished",
        "patrol_all_blocked",
        "patrol_arrived",
        "patrol_destination_selected",
        "quiet_tick",
        "return_home_ready",
        "wait_finished_no_target"
      ]
    },
    "before": {
      "$ref": "#/$defs/actor_ai_projection"
    },
    "after": {
      "$ref": "#/$defs/actor_ai_projection"
    },
    "stopped_root_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:accepted-direct-attack-identity:v1#/$defs/action_id"
      }
    }
  },
  "$defs": {
    "actor_ai_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_state",
        "target_actor_id_or_null",
        "patrol_destination_or_null",
        "remaining_ai_wait_steps",
        "hp",
        "accepted_action_id_or_null"
      ],
      "properties": {
        "ai_state": {
          "enum": [
            "idle",
            "patrol",
            "chase",
            "attack",
            "return"
          ]
        },
        "target_actor_id_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "patrol_destination_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:solorxjh:character-location:v1#/properties/position"
            }
          ]
        },
        "remaining_ai_wait_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accepted_action_id_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:solorxjh:accepted-direct-attack-identity:v1#/$defs/action_id"
            }
          ]
        }
      }
    }
  },
