{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:death-reward-pool:v1",
  "$comment": "原唯一死亡共同决定中单个共享资源池，base为合法绝命修正后的原基值；只存分池结果，不重复存人数/总权重/余数缓存。资格/顺序/公式及实际个人倍率封顶另验；不是独立发奖事件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "pool",
    "allocations"
  ],
  "properties": {
    "base": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pool": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "level",
          "allocated"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          },
          "allocated": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
