{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:supreme-service-activation-event:v1",
  "$comment": "至尊10/30游戏日服务激活/续期三阶段原事件；物品来源、权益余额算术、修订/计时隔离及同父保存另验。完整效果未采用前仍禁止使用。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "stack_flows",
        "service_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "urn:solorxjh:stack-flow:v1",
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "outputs": {
                "maxItems": 1,
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "enum": [
                            "supreme_hotblood_talisman_10d",
                            "supreme_hotblood_talisman_30d"
                          ]
                        },
                        "binding": {
                          "const": "character"
                        },
                        "quest_scope": {
                          "type": "null"
                        },
                        "quantity": {
                          "maximum": 98
                        },
                        "revision": {
                          "minimum": 1
                        }
                      }
                    },
                    "contributions": {
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "properties": {
                          "input_index": {
                            "const": 0
                          },
                          "quantity": {
                            "maximum": 98
                          }
                        }
                      }
                    },
                    "custody": {
                      "properties": {
                        "kind": {
                          "const": "held"
                        }
                      }
                    }
                  }
                }
              },
              "consumptions": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "input_index": {
                      "const": 0
                    },
                    "quantity": {
                      "const": 1
                    },
                    "reason": {
                      "const": "use"
                    }
                  }
                }
              },
              "mint_authorization": {
                "type": "null"
              }
            }
          }
        },
        "service_after": {
          "$ref": "urn:solorxjh:supreme-service-state:v1",
          "type": "object",
          "properties": {
            "remaining_steps": {
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "stack_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "stack_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "stack_input",
        "service_before",
        "item_id",
        "duration_steps",
        "planned_remaining_steps"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "stack_input": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        },
        "service_before": {
          "$ref": "urn:solorxjh:supreme-service-state:v1"
        },
        "item_id": {
          "enum": [
            "supreme_hotblood_talisman_10d",
            "supreme_hotblood_talisman_30d"
          ]
        },
        "duration_steps": {
          "enum": [
            51840000,
            155520000
          ]
        },
        "planned_remaining_steps": {
          "type": "integer",
          "minimum": 51840000,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "item_id": {
                "const": "supreme_hotblood_talisman_10d"
              }
            }
          },
          "then": {
            "properties": {
              "duration_steps": {
                "const": 51840000
              }
            }
          },
          "else": {
            "properties": {
              "duration_steps": {
                "const": 155520000
              },
              "planned_remaining_steps": {
                "minimum": 155520000
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:supreme-service-activation-event:v1"
      }
    }
  }
}
