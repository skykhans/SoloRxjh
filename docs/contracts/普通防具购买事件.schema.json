{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ordinary-armor-purchase-event:v1",
  "$comment": "银娇龙普通防具原购买三阶段事件；仅1219已定义普通防具，1..99独立新实例与一笔随身银两支出。实际目录/价格/数量等式、同角色归属/布局/容量/完整来源及修订另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "instance_flow",
        "silver_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "instance_flow": {
          "$ref": "#/$defs/purchase_instance_flow"
        },
        "silver_flow": {
          "$ref": "#/$defs/purchase_silver_flow"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id",
        "item_id",
        "quantity"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "item_id": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:catalog-armor-instance:v1#/properties/item_id"
            },
            {
              "pattern": "^armor_regular_"
            }
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "unit_price",
        "equipment_bag_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "unit_price": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "equipment_bag_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/equipment_bag"
        }
      }
    },
    "purchase_instance_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:instance-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "maxItems": 0
            },
            "retirements": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 99,
              "items": {
                "properties": {
                  "operation": {
                    "const": "create"
                  },
                  "source_input_indices": {
                    "maxItems": 0
                  },
                  "custody": {
                    "const": {
                      "kind": "held"
                    }
                  },
                  "instance": {
                    "allOf": [
                      {
                        "$ref": "urn:solorxjh:catalog-armor-instance:v1"
                      },
                      {
                        "properties": {
                          "enhancement": {
                            "const": 0
                          },
                          "synthesis_entries": {
                            "const": []
                          },
                          "awakening_stage": {
                            "const": 0
                          },
                          "element_attribute": {
                            "const": null
                          },
                          "evolution_tier": {
                            "const": 0
                          },
                          "four_divine_state": {
                            "const": null
                          },
                          "jade_attributes": {
                            "const": []
                          },
                          "enhancement_boost": {
                            "const": null
                          },
                          "item_id": {
                            "allOf": [
                              {
                                "$ref": "urn:solorxjh:catalog-armor-instance:v1#/properties/item_id"
                              },
                              {
                                "pattern": "^armor_regular_"
                              }
                            ]
                          },
                          "revision": {
                            "const": 0
                          },
                          "merit_equipment": {
                            "const": false
                          }
                        }
                      }
                    ]
                  },
                  "creation_authorization": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "npc_purchase"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "purchase_silver_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:silver-flow:v1"
        },
        {
          "properties": {
            "accounts": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "account": {
                    "const": "carried_silver"
                  },
                  "previous_output": {
                    "type": "object"
                  },
                  "opening_authorization": {
                    "type": "null"
                  }
                }
              }
            },
            "movements": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "from_account_index": {
                    "const": 0
                  },
                  "to_account_index": {
                    "type": "null"
                  },
                  "authorization": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "npc_purchase"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:ordinary-armor-purchase-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
