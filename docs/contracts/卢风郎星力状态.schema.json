{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:lu-star-power-state:v1",
  "$comment": "唯一character.effects.lu_star_power；null为无下一次攻击武功威力翻倍。队列/投射物及已接纳动作快照由原动作结果持有，不在本组件复制。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_event_id",
        "remaining_steps"
      ],
      "properties": {
        "trigger_event_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      }
    }
  ]
}
