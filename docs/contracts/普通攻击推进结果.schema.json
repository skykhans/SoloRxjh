{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:normal-attack-advance:v1",
  "$comment": "原movement_and_due_capture父决定持有的普通根十键推进子结果，不新增日志/游标。after=before+1、真实根前后/获授步/发射到期/首次完成及同笔副作用另验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "world_step",
    "action_id",
    "before_elapsed_steps",
    "after_elapsed_steps",
    "dispatch_event_id_or_null"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 79,
      "maxLength": 79,
      "pattern": "^normal-advance:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_id": {
      "$ref": "urn:solorxjh:combat-resolution-batch:v1#/properties/world_id"
    },
    "authority_profile_id": {
      "$ref": "urn:solorxjh:combat-resolution-batch:v1#/properties/authority_profile_id"
    },
    "map_id": {
      "$ref": "urn:solorxjh:combat-resolution-batch:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "$ref": "urn:solorxjh:combat-resolution-batch:v1#/properties/instance_id_or_null"
    },
    "world_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action_id": {
      "$ref": "urn:solorxjh:accepted-direct-attack-identity:v1#/$defs/action_id"
    },
    "before_elapsed_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "after_elapsed_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "dispatch_event_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:solorxjh:normal-attack-dispatch:v1#/$defs/event_id"
        }
      ]
    }
  }
}
