{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:loadout-switch-event:v1",
  "$comment": "主辅装备组切换原三阶段事件。目标全部资格/实例来源、两修订+1、预算及资源下裁按原owner语义校验；无物品移动/消费流。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "active_loadout_after",
        "anti_allocations_after",
        "loadout_switch_remaining_ms",
        "hp_after",
        "mana_after",
        "stamina_after",
        "special_resources_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "active_loadout_after": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "anti_allocations_after": {
          "$ref": "urn:solorxjh:anti-qigong-state:v1#/$defs/allocations"
        },
        "loadout_switch_remaining_ms": {
          "const": 1000
        },
        "hp_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mana_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stamina_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "special_resources_after": {
          "$ref": "urn:solorxjh:class-special-resources:v1"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "target_loadout_id",
        "confirm_anti_allocation_clear"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "target_loadout_id": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "confirm_anti_allocation_clear": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "active_loadout_before",
        "anti_allocations_before",
        "clear_anti_allocations",
        "class_id"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "active_loadout_before": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "anti_allocations_before": {
          "$ref": "urn:solorxjh:anti-qigong-state:v1#/$defs/allocations"
        },
        "clear_anti_allocations": {
          "type": "boolean"
        },
        "class_id": {
          "enum": [
            "blade",
            "sword",
            "spear",
            "physician",
            "archer",
            "assassin",
            "musician",
            "fighter",
            "han_feiguan",
            "tan_hualing",
            "mei_liuzhen",
            "lu_fenglang",
            "dongling_shennv",
            "zhen_fengbai"
          ]
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:loadout-switch-event:v1"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "target_loadout_id": {
                "const": "primary"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "active_loadout_before": {
                "const": "secondary"
              }
            }
          },
          "active_loadout_after": {
            "const": "primary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "target_loadout_id": {
                "const": "secondary"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "active_loadout_before": {
                "const": "primary"
              }
            }
          },
          "active_loadout_after": {
            "const": "secondary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "clear_anti_allocations": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "confirm_anti_allocation_clear": {
                "const": true
              }
            }
          },
          "anti_allocations_after": {
            "additionalProperties": {
              "const": 0
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "blade"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "sword"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "spear"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "physician"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "archer"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "assassin"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/assassin"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "musician"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/musician"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "fighter"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "han_feiguan"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/han_feiguan"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "tan_hualing"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "mei_liuzhen"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/mei_liuzhen"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "lu_fenglang"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "dongling_shennv"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/other_class"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "class_id": {
                "const": "zhen_fengbai"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "special_resources_after": {
            "$ref": "urn:solorxjh:class-special-resources:v1#/$defs/zhen_fengbai"
          }
        }
      }
    }
  ]
}
