{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:legacy-equipment-instance:v1",
  "$comment": "七件旧兼容装备完整九键，仅真实强化0..3。旧导入保原强化但业务revision从0建来源；ID/导入授权/前后版本及权限语义另验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "lineage_id",
    "owner_character_id",
    "creation_receipt_id",
    "state_origin_receipt_id",
    "item_id",
    "binding",
    "revision",
    "enhancement"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner_character_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "creation_receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "state_origin_receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "item_id": {
      "enum": [
        "fuxian_sword",
        "ironwood_blade",
        "refined_blade",
        "frost_edge",
        "menial_robe",
        "leather_armor",
        "dark_iron_armor"
      ]
    },
    "binding": {
      "const": "character"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enhancement": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  }
}
