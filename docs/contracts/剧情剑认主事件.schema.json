{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:story-sword-binding-event:v1",
  "$comment": "Q001原认主三阶段事件；不另建剑气领取日志。原实例/来源、职业、阶段、修订与origin收据同笔绑定须语义核验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "story_stage_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "story_stage_after": {
          "const": "gathering"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interaction_id": {
          "const": "story_bind_sword"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "story_stage_before",
        "story_instance_id",
        "class_id",
        "legacy_sword_before",
        "grant_mode"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "story_stage_before": {
          "const": "bind_sword"
        },
        "story_instance_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "class_id": {
          "enum": [
            "blade",
            "sword",
            "spear",
            "physician",
            "archer",
            "assassin",
            "musician",
            "fighter",
            "han_feiguan",
            "tan_hualing",
            "mei_liuzhen",
            "lu_fenglang",
            "dongling_shennv",
            "zhen_fengbai"
          ]
        },
        "legacy_sword_before": {
          "$ref": "urn:solorxjh:legacy-sword-learning-state:v1"
        },
        "grant_mode": {
          "enum": [
            "new_sword",
            "imported_sword",
            "other_class"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grant_mode": {
                "const": "new_sword"
              }
            }
          },
          "then": {
            "properties": {
              "class_id": {
                "const": "sword"
              },
              "legacy_sword_before": {
                "properties": {
                  "origin_ref": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "grant_mode": {
                "const": "imported_sword"
              }
            }
          },
          "then": {
            "properties": {
              "class_id": {
                "const": "sword"
              },
              "legacy_sword_before": {
                "properties": {
                  "origin_ref": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "legacy_import"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "grant_mode": {
                "const": "other_class"
              }
            }
          },
          "then": {
            "properties": {
              "class_id": {
                "enum": [
                  "blade",
                  "spear",
                  "physician",
                  "archer",
                  "assassin",
                  "musician",
                  "fighter",
                  "han_feiguan",
                  "tan_hualing",
                  "mei_liuzhen",
                  "lu_fenglang",
                  "dongling_shennv",
                  "zhen_fengbai"
                ]
              },
              "legacy_sword_before": {
                "properties": {
                  "origin_ref": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:story-sword-binding-event:v1"
      }
    }
  }
}
