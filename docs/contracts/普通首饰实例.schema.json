{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ordinary-jewelry-instance:v1",
  "$comment": "79款普通首饰完整单实例白名单，不是档案/库存/收据schema。严格整数token、定义及历史/所有权语义须另验；integer不拒绝1.0。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "item_id",
    "lineage_id",
    "owner_character_id",
    "binding",
    "revision",
    "creation_receipt_id",
    "processing_level",
    "processing_origin_receipt_id"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_character_id": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "const": "character"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "creation_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "processing_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "processing_origin_receipt_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "$defs": {
    "processingParameterOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ordinary": {
          "$ref": "#/$defs/processingProfileOverride"
        },
        "master": {
          "$ref": "#/$defs/processingProfileOverride"
        }
      }
    },
    "processingProfileOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "overall_success_probability_bp_by_source_level": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "silver_fee_by_source_level": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "processingProfileOverrideChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "overall_success_probability_bp_by_source_level": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/processingProfileOverride/properties/overall_success_probability_bp_by_source_level"
            }
          ]
        },
        "silver_fee_by_source_level": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/processingProfileOverride/properties/silver_fee_by_source_level"
            }
          ]
        }
      }
    },
    "processingParameterOverrideChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ordinary": {
          "$ref": "#/$defs/processingProfileOverrideChanges"
        },
        "master": {
          "$ref": "#/$defs/processingProfileOverrideChanges"
        }
      }
    }
  }
}
