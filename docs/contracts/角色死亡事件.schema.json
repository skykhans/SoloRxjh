{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:character-death-event:v1",
  "$comment": "原角色真实终态死亡三阶段；authority-only致死来源/同步死亡与实际五槽副作用。不能先提交active HP0，不允许用户取消。完整致死原事件、拦截/活动/实例流与候选另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "committed_world_step",
        "instance_flow",
        "offensive_stop",
        "dodge_stop_or_null",
        "cancelled_portable_channel_id_or_null",
        "cancelled_support_action_id_or_null"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instance_flow": {
          "$ref": "#/$defs/death_instance_flow"
        },
        "offensive_stop": {
          "$ref": "#/$defs/offensive_stop"
        },
        "dodge_stop_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:solorxjh:dodge-stop:v1",
              "properties": {
                "reason": {
                  "const": "death"
                }
              }
            }
          ]
        },
        "cancelled_portable_channel_id_or_null": {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/cancelled_portable_channel_id_or_null"
        },
        "cancelled_support_action_id_or_null": {
          "$ref": "urn:solorxjh:player-support-cast:v1#/$defs/cancelled_support_action_id_or_null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cancelled_support_action_id_or_null": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "dodge_stop_or_null": {
                "type": "null"
              },
              "cancelled_portable_channel_id_or_null": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "session_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "expected_character_revision",
        "expected_inventory_revision",
        "lethal_event_id",
        "due_world_step"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lethal_event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "due_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "pending_death_after",
        "equipment_before",
        "death_location"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "pending_death_after": {
          "$ref": "urn:solorxjh:character-life-state:v1#/$defs/pending_death"
        },
        "equipment_before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ring_a",
            "ring_b",
            "earring_a",
            "earring_b",
            "necklace"
          ],
          "properties": {
            "ring_a": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:adopted-equipment-instance:v1"
                }
              ]
            },
            "ring_b": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:adopted-equipment-instance:v1"
                }
              ]
            },
            "earring_a": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:adopted-equipment-instance:v1"
                }
              ]
            },
            "earring_b": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:adopted-equipment-instance:v1"
                }
              ]
            },
            "necklace": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:adopted-equipment-instance:v1"
                }
              ]
            }
          }
        },
        "death_location": {
          "$ref": "urn:solorxjh:character-location:v1"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pending_death_after": {
                "required": [
                  "training_gate_choice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "death_location": {
                "properties": {
                  "map_id": {
                    "enum": [
                      "training_beihai_01",
                      "training_beihai_02",
                      "training_beihai_03",
                      "training_beihai_04",
                      "training_beihai_05",
                      "training_beihai_06",
                      "training_beihai_07",
                      "training_beihai_08",
                      "training_beihai_09",
                      "training_nanlin_01",
                      "training_nanlin_02",
                      "training_nanlin_03",
                      "training_nanlin_04",
                      "training_nanlin_05",
                      "training_nanlin_06",
                      "training_nanlin_07",
                      "training_nanlin_08",
                      "training_nanlin_09",
                      "training_dongling_01",
                      "training_dongling_02",
                      "training_dongling_03",
                      "training_dongling_04",
                      "training_dongling_05",
                      "training_dongling_06",
                      "training_dongling_07",
                      "training_dongling_08",
                      "training_dongling_09",
                      "training_huxia_01",
                      "training_huxia_02",
                      "training_huxia_03",
                      "training_huxia_04",
                      "training_huxia_05",
                      "training_huxia_06",
                      "training_huxia_07",
                      "training_huxia_08",
                      "training_huxia_09"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "death_location": {
                "properties": {
                  "map_id": {
                    "not": {
                      "enum": [
                        "training_beihai_01",
                        "training_beihai_02",
                        "training_beihai_03",
                        "training_beihai_04",
                        "training_beihai_05",
                        "training_beihai_06",
                        "training_beihai_07",
                        "training_beihai_08",
                        "training_beihai_09",
                        "training_nanlin_01",
                        "training_nanlin_02",
                        "training_nanlin_03",
                        "training_nanlin_04",
                        "training_nanlin_05",
                        "training_nanlin_06",
                        "training_nanlin_07",
                        "training_nanlin_08",
                        "training_nanlin_09",
                        "training_dongling_01",
                        "training_dongling_02",
                        "training_dongling_03",
                        "training_dongling_04",
                        "training_dongling_05",
                        "training_dongling_06",
                        "training_dongling_07",
                        "training_dongling_08",
                        "training_dongling_09",
                        "training_huxia_01",
                        "training_huxia_02",
                        "training_huxia_03",
                        "training_huxia_04",
                        "training_huxia_05",
                        "training_huxia_06",
                        "training_huxia_07",
                        "training_huxia_08",
                        "training_huxia_09"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:character-death-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "death_instance_flow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "allOf": [
            {
              "$ref": "urn:solorxjh:instance-flow:v1"
            },
            {
              "properties": {
                "inputs": {
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "properties": {
                      "instance": {
                        "oneOf": [
                          {
                            "$ref": "urn:solorxjh:chuchen-ring-instance:v1"
                          },
                          {
                            "$ref": "urn:solorxjh:merit-jewelry-instance:v1"
                          }
                        ]
                      },
                      "custody": {
                        "properties": {
                          "kind": {
                            "const": "held"
                          }
                        }
                      }
                    }
                  }
                },
                "outputs": {
                  "maxItems": 5,
                  "items": {
                    "properties": {
                      "operation": {
                        "const": "revise"
                      },
                      "instance": {
                        "$ref": "urn:solorxjh:merit-jewelry-instance:v1"
                      }
                    }
                  }
                },
                "retirements": {
                  "maxItems": 2,
                  "items": {
                    "properties": {
                      "reason": {
                        "const": "death_consumption"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "offensive_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_actor_id",
        "root_event_ids"
      ],
      "properties": {
        "source_actor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "root_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "$comment": "原死亡结果内停止清单，不是新事件/队列表。实际死者实体生命轮次、scope、严格UTF8排序与原world完整before进攻根集合精确相等另验；空数组只能证明实际没有动作占用或未落效进攻子项。"
    }
  }
}
