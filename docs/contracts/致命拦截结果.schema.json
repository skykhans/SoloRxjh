{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:lethal-interception-result:v1",
  "$comment": "原伤害内实际选择并掷出一次概率的致命拦截子结果，严格13字段；火凤/霸王留10，血魔留1。完整资格/活动/HP/随机流及同笔效果另验，不是独立日志。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "target_actor_id",
    "incoming_damage_event_id",
    "selected_profile",
    "chance_bp",
    "hp_before",
    "valid_max_hp",
    "outcome",
    "random_flow"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 81,
      "maxLength": 81,
      "pattern": "^lethal-intercept:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:character-location:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "target_actor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "incoming_damage_event_id": {
      "$ref": "urn:solorxjh:combat-damage-identity:v1#/$defs/event_id"
    },
    "selected_profile": {
      "enum": [
        "bawang_lethal",
        "lethal_keep10",
        "blood_devil"
      ]
    },
    "chance_bp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4000
    },
    "hp_before": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "valid_max_hp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "outcome": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "random_flow": {
      "$ref": "urn:solorxjh:random-decision-flow:v1",
      "properties": {
        "streams": {
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "properties": {
              "draws": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "low": {
                      "const": 0
                    },
                    "high": {
                      "const": 9999
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "urn:solorxjh:world-step-state:v1#/$defs/instance_binding"
    },
    {
      "if": {
        "properties": {
          "selected_profile": {
            "enum": [
              "bawang_lethal",
              "lethal_keep10"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "valid_max_hp": {
            "minimum": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_profile": {
            "enum": [
              "bawang_lethal",
              "lethal_keep10"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "random_flow": {
            "properties": {
              "streams": {
                "items": {
                  "properties": {
                    "owner_kind": {
                      "const": "character"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
