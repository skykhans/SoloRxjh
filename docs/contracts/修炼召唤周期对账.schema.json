    },
    "stopped_root_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:accepted-direct-attack-identity:v1#/$defs/action_id"
      }
    }
  },
  "$defs": {
    "slot_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_index",
        "state",
        "active_actor_id_or_null",
        "last_observed_world_step"
      ],
      "properties": {
        "cycle_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "pending",
            "alive",
            "killed",
            "expired_without_spawn",
            "expired_alive_removed"
          ]
        },
        "active_actor_id_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 79,
              "maxLength": 79,
              "pattern": "^training-actor:[0-9a-f]{64}(?![\\s\\S])"
            }
          ]
        },
        "last_observed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "alive"
              }
            }
          },
          "then": {
            "properties": {
              "active_actor_id_or_null": {
                "type": "string",
                "minLength": 79,
                "maxLength": 79,
                "pattern": "^training-actor:[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "else": {
            "properties": {
              "active_actor_id_or_null": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "before": {
              "properties": {
                "state": {
                  "const": "pending"
                }
              }
            },
            "after": {
              "properties": {
                "state": {
                  "enum": [
                    "pending",
                    "expired_without_spawn"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "before": {
              "properties": {
                "state": {
                  "const": "alive"
                }
              }
            },
            "after": {
              "properties": {
                "state": {
                  "enum": [
                    "alive",
                    "expired_alive_removed",
                    "pending",
                    "expired_without_spawn"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "before": {
              "properties": {
                "state": {
                  "const": "killed"
                }
              }
            },
            "after": {
              "properties": {
                "state": {
                  "enum": [
                    "killed",
                    "pending",
                    "expired_without_spawn"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "before": {
              "properties": {
                "state": {
                  "const": "expired_without_spawn"
                }
              }
            },
            "after": {
              "properties": {
                "state": {
                  "enum": [
                    "expired_without_spawn",
                    "pending"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "before": {
              "properties": {
                "state": {
                  "const": "expired_alive_removed"
                }
              }
            },
            "after": {
              "properties": {
                "state": {
                  "enum": [
                    "expired_alive_removed",
                    "pending",
                    "expired_without_spawn"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "before": {
            "properties": {
              "state": {
                "const": "alive"
              }
            }
          },
          "after": {
            "properties": {
              "state": {
                "not": {
                  "const": "alive"
                }
              }
            }
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "stopped_root_event_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ]
