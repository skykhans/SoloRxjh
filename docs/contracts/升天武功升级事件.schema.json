{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ascended-martial-upgrade-event:v1",
  "$comment": "升天攻击武功相邻阶段升级唯一三阶段事件。真实资格/阶段/支出/余额/修订与原账来源另验；不读书、不初始化、不含配置调整。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "phase_after",
        "spent_points",
        "ascension_unallocated_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase_after": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "spent_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "ascension_unallocated_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "ability_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ability_id": {
          "$ref": "urn:solorxjh:ascended-martial-learning-state:v1#/propertyNames"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "phase_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "phase_before": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:ascended-martial-upgrade-event:v1"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "ability_id": {
                "const": "ascended_han_feiguan_any_eb88d1778b5d"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "phase_before": {
                "maximum": 8
              }
            }
          },
          "phase_after": {
            "maximum": 9
          },
          "spent_points": {
            "maximum": 8
          }
        }
      }
    }
  ]
}
