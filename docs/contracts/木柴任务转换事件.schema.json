{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:firewood-task-transition-event:v1",
  "$comment": "寻找木柴原接取/确认放弃三阶段共用身份与日志。accept不动钱物；abandon清两分区本任务全部实物，零物时null数量流。前后状态/来源/数量全集/修订与完整父另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "quest_after",
        "stack_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quest_after": {
          "$ref": "urn:solorxjh:firewood-quest-state:v1"
        },
        "stack_flow": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "urn:solorxjh:stack-flow:v1"
                },
                {
                  "properties": {
                    "inputs": {
                      "minItems": 1,
                      "maxItems": 15
                    },
                    "outputs": {
                      "maxItems": 0
                    },
                    "consumptions": {
                      "minItems": 1,
                      "maxItems": 15,
                      "items": {
                        "properties": {
                          "quantity": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 15
                          },
                          "reason": {
                            "const": "quest_cleanup"
                          }
                        }
                      }
                    },
                    "mint_authorization": {
                      "type": "null"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "operation": {
                "const": "accept"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "quest_before": {
                "properties": {
                  "phase": {
                    "const": "not_accepted"
                  }
                }
              },
              "inputs": {
                "maxItems": 0
              }
            }
          },
          "quest_after": {
            "properties": {
              "phase": {
                "const": "active"
              }
            }
          },
          "stack_flow": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "operation": {
                "const": "abandon"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "quest_before": {
                "properties": {
                  "phase": {
                    "const": "active"
                  }
                }
              }
            }
          },
          "quest_after": {
            "properties": {
              "phase": {
                "const": "not_accepted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "inputs": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stack_flow": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "stack_flow": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id",
        "operation"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interaction_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "operation": {
          "enum": [
            "accept",
            "abandon"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "accept"
              }
            }
          },
          "then": {
            "properties": {
              "interaction_id": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "interaction_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs",
        "knight_bag_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "quest_before": {
          "$ref": "urn:solorxjh:firewood-quest-state:v1"
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "previous_output",
              "stack"
            ],
            "properties": {
              "previous_output": {
                "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
              },
              "stack": {
                "allOf": [
                  {
                    "$ref": "urn:solorxjh:item-stack:v1"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "const": "quest_firewood"
                      },
                      "binding": {
                        "const": "character"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15
                      },
                      "quest_scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "quest_id"
                        ],
                        "properties": {
                          "quest_id": {
                            "const": "ref_QREF-63791-006"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "knight_bag_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/knight_bag"
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:firewood-task-transition-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
