  "contribution_policy": {
    "shared_owner_ref": {
      "file": "普通首饰基础定义.v1.json",
      "pointer": "/contribution_policy"
    },
    "scope": "当前生效组五个真实首饰槽，精确定义/实例合法、等级转职及69资格满足且durability>0才贡献基础/加工/套装；备用组、背包、仓库无贡献。合法失资格/耐久0可保原位置；坏单位/未知字段或坏实例必须拒绝，不能当失效忽略。",
    "shared_stages": "9款的同名13字段与66普通79款在同一来源聚合阶段求和一次。平量/rating/气功/技能平量百分/唯一命中/主目标一次追伤的范围、取整、动作快照和防守实时规则均沿66，不为两个目录另做一次取整、命中或追伤。耳环/戒指各两独立实例合法叠加。",
    "processing_curve": "对每个13字段、真实加工n=0..10：additional(n)=floor(processing_10_additional_contributions[field]*n*n/100)。当前总贡献=base+additional(n)，不累加0..n各级；这是项目平方曲线，不是从图反推官网逐级表。先验乘法安全界，不浮点。",
    "probability_endpoint": "项链+10武功回避显示百分比采用基础+加工后的该物品总值，故斗魂附加0、天武附加2000bp、破天附加4000bp；戒指+10武功命中为加工新增1000bp。平量增加行全为额外贡献，基础追伤与加工追伤相加后与其余来源统一一次。",
    "anti_qigong": "本9款基础/加工/套装均明确0直接反气功点；170破天不因等级或相似名称继承67青玄/鸿轩耳环预算。全部气功等级仍仅按升级发点owner影响已学已分配项。"
  },
  "set_policy": {
    "count": "按set_id分别统计当前生效组中本合同合法且耐久>0/资格满足的独立实例；同款双耳双戒各真实实例计1，单实例不能重复占槽；只按真实定义set_id，不按名字/加工等级/总历史拥有数。每套计0..5，混搭可同时激活两个套装。",
    "tiers": "每套对所有piece_count<=当前计数的档逐项累加，0/1件无档；多套合法档同来源字段再求和。换装/耐久/资格变化只重算，绝不缓存永久解锁或重复授奖。原表未公开累加语义，此为项目明确选择。",
    "units": "原档武功命中/回避与对人战斗力分别采用百分数转100bp，罡气为独立平量评分。武功命中/回避与基础/加工来源合并后交23最终封顶一次；不是rating或第二次闪避。",
    "gangqi": "gangqi_flat在精金血气owner中作为独立装备平量求和，再交18最终覆盖。不会被配对精金气功抑制、不会增加普通防御或反气功预算。",
    "durability_loss": "死亡损耗从同一死亡前生效构筑取五槽快照后一次应用，套装按最终五槽状态重算一次，不能每减少一件递归扣耐久/重复结算。"
  },
  "npc_duel_damage": {
    "scope": "仅既有明确npc_martial_duel中的敌对root normal_attack/attack_martial_skill根直接命中，包括原根投射物；不用于玩家PvP、普通野怪/非比武/周期/派生/反射/环境或自付。对人战斗力在本地明确改为这项NPC比武增伤。",
    "formula": "已接受动作快照攻击侧当前合法各套装npc_duel_damage_bonus_bp之和S；在四神根对阵倍率之后、通用百分减伤/护盾之前，floor(incoming*(10000+S)/10000)一次。防守方不因同名战斗力自动减伤，不产生额外命中/暴击或触发。无合法套装时显式S=0。",
    "snapshot": "S随根动作保存；换装/失资格/耐久归0不追改已接受动作，后续动作按新构筑。防守武功回避与罡气在实际命中取当前值。NPC使用明确固定空首饰投影，不从缺字段补空；未来具名投影须独立采用。",
