{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:heavenly-stone-claim-event:v1",
  "$comment": "待领天机石领取原三阶段事件，待领扣减与1..9999本人石实物同笔；一铸造及可选合堆。资格、pending/数量等式、原堆/布局/来源/跨flow守恒另验，不是技能退款或点数转换。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "stack_flows",
        "unclaimed_heavenly_stones_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "urn:solorxjh:stack-flow:v1",
              "properties": {
                "inputs": {
                  "maxItems": 0
                },
                "outputs": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "heavenly_stone"
                          },
                          "binding": {
                            "const": "character"
                          },
                          "quest_scope": {
                            "type": "null"
                          },
                          "quantity": {
                            "minimum": 1,
                            "maximum": 9999
                          },
                          "revision": {
                            "const": 0
                          }
                        }
                      },
                      "custody": {
                        "properties": {
                          "kind": {
                            "const": "held"
                          }
                        }
                      },
                      "contributions": {
                        "maxItems": 0
                      }
                    }
                  }
                },
                "consumptions": {
                  "maxItems": 0
                },
                "mint_authorization": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "cultivation_claim"
                    }
                  }
                }
              }
            },
            {
              "$ref": "urn:solorxjh:stack-flow:v1",
              "properties": {
                "inputs": {
                  "minItems": 2,
                  "maxItems": 201
                },
                "outputs": {
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "heavenly_stone"
                          },
                          "binding": {
                            "const": "character"
                          },
                          "quest_scope": {
                            "type": "null"
                          },
                          "quantity": {
                            "minimum": 1,
                            "maximum": 9999
                          }
                        }
                      },
                      "custody": {
                        "properties": {
                          "kind": {
                            "const": "held"
                          }
                        }
                      }
                    }
                  }
                },
                "consumptions": {
                  "maxItems": 0
                },
                "mint_authorization": {
                  "type": "null"
                }
              }
            }
          ],
          "items": false
        },
        "unclaimed_heavenly_stones_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "quantity"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "cultivation_before",
        "inventory_before",
        "merge_inputs"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "cultivation_before": {
          "$ref": "urn:solorxjh:cultivation-state:v1"
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "merge_inputs": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
          }
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:heavenly-stone-claim-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
