{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:knight-bag-overweight:v1",
  "$comment": "角色行囊合法到期超重来源，null为无凭证；三键只定位原世界计时共同父与到期前库存修订，不复制重量/容量/物品。必须解析实际本人档案1→0及原完整库存、当前减负链，不能以结构通过授权超重。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "world_step",
        "inventory_revision_at_expiry"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "world_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_at_expiry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  ]
}
