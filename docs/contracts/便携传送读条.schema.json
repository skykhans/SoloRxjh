{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:portable-travel-channel:v1",
  "$comment": "character.portable_travel_channel_or_null，空闲null或九键已接纳读条。channel_id沿原接纳唯一身份，原正式接纳/推进/取消/迁移决定尚须闭合。预留只引用不复制物品/存点/权益余额，冷却沿原timers。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "$ref": "#/$defs/channel"
    }
  ],
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "channel_id",
        "action_kind",
        "accepted_world_step",
        "rules_hash",
        "source_location",
        "remaining_steps",
        "authorization",
        "destination_point_or_null"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "channel_id": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1#/properties/settlement_id"
        },
        "action_kind": {
          "enum": [
            "portable_return",
            "earth_spirit_travel",
            "supreme_talisman_travel"
          ]
        },
        "accepted_world_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rules_hash": {
          "$ref": "urn:solorxjh:supreme-service-clock-result:v1#/properties/rules_hash"
        },
        "source_location": {
          "$ref": "urn:solorxjh:character-location:v1"
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "authorization": {
          "oneOf": [
            {
              "$ref": "#/$defs/item_authorization"
            },
            {
              "$ref": "#/$defs/supreme_authorization"
            }
          ]
        },
        "destination_point_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/point_reference"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "portable_return"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "allOf": [
                  {
                    "$ref": "#/$defs/item_authorization"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "enum": [
                          "return_talisman",
                          "return_liuzheng",
                          "return_sanxie",
                          "return_shenwu",
                          "return_liushan",
                          "return_beihai"
                        ]
                      }
                    }
                  }
                ]
              },
              "destination_point_or_null": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "earth_spirit_travel"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "allOf": [
                  {
                    "$ref": "#/$defs/item_authorization"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "enum": [
                          "earth_spirit_talisman"
                        ]
                      }
                    }
                  }
                ]
              },
              "destination_point_or_null": {
                "$ref": "#/$defs/point_reference"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "supreme_talisman_travel"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "$ref": "#/$defs/supreme_authorization"
              },
              "destination_point_or_null": {
                "$ref": "#/$defs/point_reference"
              }
            }
          }
        }
      ]
    },
    "item_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "item_id",
        "stack_id",
        "stack_revision"
      ],
      "properties": {
        "kind": {
          "const": "item"
        },
        "item_id": {
          "enum": [
            "return_talisman",
            "return_liuzheng",
            "return_sanxie",
            "return_shenwu",
            "return_liushan",
            "return_beihai",
            "earth_spirit_talisman"
          ]
        },
        "stack_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stack_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "supreme_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "profile_id",
        "source_receipt_id"
      ],
      "properties": {
        "kind": {
          "const": "supreme"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_receipt_id": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1#/properties/settlement_id"
        }
      }
    },
    "point_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "revision"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "cancelled_portable_channel_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/channel/properties/channel_id"
        }
      ]
    }
  }
}
