{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:armor-suppression-state:v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_actor_id",
      "source_ability_id",
      "trigger_event_id",
      "remaining_steps"
    ],
    "properties": {
      "source_actor_id": {
        "type": "string",
        "pattern": "\\S"
      },
      "source_ability_id": {
        "enum": [
          "qigong_assassin_38fc56f07575",
          "qigong_archer_38fc56f07575",
          "qigong_mei_liuzhen_38fc56f07575",
          "qigong_zhen_fengbai_38fc56f07575"
        ]
      },
      "trigger_event_id": {
        "type": "string",
        "pattern": "\\S"
      },
      "remaining_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 180
      }
    }
  },
  "$comment": "唯一effects.armor_suppression；四具名气功决定唯一固定槽位mask，不另存可伪造mask/物品贡献差值。原结果冻结rules_hash与mask和实际预算/超载变化。"
}
