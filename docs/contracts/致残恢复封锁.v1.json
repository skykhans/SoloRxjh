  "status": "fourteen_shared_passive_effects_adopted_not_implemented",
  "source_policy": "14个原致残气功都明确3秒不能恢复生命、梅柳真同时禁障力；神女/甄凤柏原文另明攻速影响概率。以下每级概率/触发时点/范围/算法/上限/堆叠为项目规则，不声称官方概率。",
  "effect_profile": {
    "id": "disable_hp_recovery3seconds",
    "duration_steps": 180,
    "effect_family": "hp_recovery_block",
    "always_blocks": [
      "instant_hp_heal",
      "periodic_hp_heal",
      "hp_potion",
      "lifesteal_hp_restore",
      "in_combat_passive_hp_restore"
    ],
    "conditional_barrier_block": "target class mei_liuzhen blocks natural/skill/passive barrier restoration; ordinary guard shields not inferred as barrier healing",
    "never_blocks": [
      "mana_recovery",
      "stamina_recovery",
      "rage_gain",
      "nonhealing_shield_activation"
    ],
    "does_not_remove_target_existing_healing_effects": true,
    "blocked_due_heal": "skip, no catchup",
    "new_restore_request_when_already_blocked": "reject before payment; already paid late-block cast gives0/no refund",
    "revive": "not treated as HP recovery; dead target cannot receive this debuff in first place"
  },
  "trigger": {
    "requires_learned_allocated_and_positive_effective_level": true,
    "eligible_attacks": [
      "normal_attack",
      "attack_martial_skill"
    ],
    "requires_actual_hostile_hp_damage": true,
    "target": "original primary only, still alive after hit; no choosing new primary after death",
    "once_per_action": true,
    "multi_hit": "first qualifying primary hit once; missed/blocked earlier hit can leave eligibility for later actual hit but never more than1draw",
    "chance_bp_per_effective_level": 100,
    "unscaled_chance_max_bp": 4000,
    "for_attack_speed_sensitive_classes": "min(4000,floor(100*effective_level*accepted_action_base_duration_steps/60))",
    "base_duration_definition": "declared windup+active+recovery after legal attack-speed timing modifiers at action accept; excludes user waiting, cooldown and variable projectile travel; snapshot once, no charge-hold increase",
    "zero_chance": "no random draw",
    "trigger_order": "after actual HP loss/resource callbacks, before anti_qigong; newly imposed block affects later due effects not already committed same hit recovery",
    "critical_or_extra_damage_changes_chance": false
  },
  "stacking": "keep distinct caster/qigong/root-event sources, block while at least one unexpired source; same caster+qigong refresh180 not add. Trigger never deletes another source or converts duration to360.",
  "persistence": "effect source IDs/remaining1..180 plus action-level check-consumed receipt; offline/pause freezes, target death clears, source disconnect does not cancel persisted remaining time. Hit event replay never draws/applies twice.",
  "named_effective_limits_owner": "升级发点.v1.json, each allocated20/effective40 explicitly listed, not universal cap",
