{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:apparel-purchase-event:v1",
  "$comment": "衣饰购买严格三阶段原事件：精确1155款、单件新生、10万随身银两。实际身份/目录/修订/来源/最低空槽/完整期限初态/原角色当前时钟语义另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "instance_flow",
        "silver_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "instance_flow": {
          "$ref": "#/$defs/purchase_instance_flow"
        },
        "silver_flow": {
          "$ref": "#/$defs/purchase_silver_flow"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id",
        "item_id",
        "quantity"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "item_id": {
          "$ref": "urn:solorxjh:apparel-catalog-id:v1"
        },
        "quantity": {
          "const": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "unit_price",
        "equipment_bag_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "unit_price": {
          "const": 100000
        },
        "equipment_bag_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/equipment_bag"
        }
      }
    },
    "purchase_instance_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:instance-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "maxItems": 0
            },
            "retirements": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "operation": {
                    "const": "create"
                  },
                  "source_input_indices": {
                    "maxItems": 0
                  },
                  "custody": {
                    "const": {
                      "kind": "held"
                    }
                  },
                  "instance": {
                    "allOf": [
                      {
                        "$ref": "urn:solorxjh:apparel-instance:v1"
                      },
                      {
                        "properties": {
                          "revision": {
                            "const": 0
                          },
                          "enhancement": {
                            "const": 0
                          },
                          "synthesis_entries": {
                            "const": []
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "item_id": {
                                  "enum": [
                                    "apparel_48735",
                                    "apparel_48734",
                                    "apparel_48733",
                                    "apparel_48732",
                                    "apparel_48731",
                                    "apparel_48730",
                                    "apparel_48729",
                                    "apparel_48728",
                                    "apparel_42609",
                                    "apparel_42608",
                                    "apparel_42605",
                                    "apparel_42604",
                                    "apparel_42603",
                                    "apparel_42602",
                                    "apparel_40080",
                                    "apparel_40079",
                                    "apparel_40074",
                                    "apparel_40073",
                                    "apparel_40072",
                                    "apparel_40071",
                                    "apparel_40068",
                                    "apparel_40067",
                                    "apparel_40066",
                                    "apparel_40065",
                                    "apparel_40064",
                                    "apparel_40063",
                                    "apparel_40062",
                                    "apparel_40061",
                                    "apparel_40060",
                                    "apparel_40059",
                                    "apparel_40058",
                                    "apparel_40057",
                                    "apparel_40056",
                                    "apparel_40055",
                                    "apparel_39992",
                                    "apparel_39991"
                                  ]
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "lifetime_remaining_steps_or_null": {
                                  "const": 5184000
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "lifetime_remaining_steps_or_null": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "creation_authorization": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "npc_purchase"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "purchase_silver_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:silver-flow:v1"
        },
        {
          "properties": {
            "accounts": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "account": {
                    "const": "carried_silver"
                  },
                  "previous_output": {
                    "type": "object"
                  },
                  "opening_authorization": {
                    "type": "null"
                  }
                }
              }
            },
            "movements": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "from_account_index": {
                    "const": 0
                  },
                  "to_account_index": {
                    "type": "null"
                  },
                  "authorization": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "npc_purchase"
                      }
                    }
                  },
                  "amount": {
                    "const": 100000
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:apparel-purchase-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
