{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ordinary-monster-life-identity:v1",
  "$comment": "公共普通怪单次实际生命的七键身份，不是完整actor。真实刷点/生成源及摘要必须另验；修炼/私场身份不按本结构转换。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "spawn_id",
    "generation",
    "actor_id"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:character-location:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "type": "null"
    },
    "spawn_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actor_id": {
      "type": "string",
      "minLength": 79,
      "maxLength": 79,
      "pattern": "^ordinary-actor:[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
