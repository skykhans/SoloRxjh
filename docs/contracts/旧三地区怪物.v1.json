  "loot_ownership": {
    "ordinary": "19 kill-owner single real drop, no all-party copies",
    "quest_boss": "one private personal quest encounter per eligible character/attempt; cannot use room-global absence to satisfy another role",
    "claim": "real backpack pickup, full bag stays in scene; committed reward event never emits same drop IDs twice",
    "save": "ordinary scene drops not persisted; warned before normal exit; already picked items preserved",
    "silver_owner_ref": {
      "file": "怪物银两掉落与拾取.v1.json",
