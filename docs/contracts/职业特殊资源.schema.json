{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:class-special-resources:v1",
  "$comment": "character.special_resources按职业精确状态，class_projection只联合校验角色两个原字段，不新增持久包装。资源来源/派生上限/职业资格另验。",
  "oneOf": [
    {
      "$ref": "#/$defs/mei_liuzhen"
    },
    {
      "$ref": "#/$defs/musician"
    },
    {
      "$ref": "#/$defs/zhen_fengbai"
    },
    {
      "$ref": "#/$defs/assassin"
    },
    {
      "$ref": "#/$defs/han_feiguan"
    },
    {
      "$ref": "#/$defs/other_class"
    }
  ],
  "$defs": {
    "mei_liuzhen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "barrier_current",
        "barrier_regen_fraction",
        "fury_points"
      ],
      "properties": {
        "barrier_current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "barrier_regen_fraction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 599999
        },
        "fury_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "musician": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chord",
        "chord_remaining_steps",
        "chord_source_event_id",
        "cycle_order",
        "cycle_next_index"
      ],
      "properties": {
        "chord": {
          "enum": [
            "none",
            "triad",
            "seventh",
            "ninth"
          ]
        },
        "chord_remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "chord_source_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "cycle_order": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "triad",
              "seventh",
              "ninth"
            ]
          }
        },
        "cycle_next_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "chord": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "chord_remaining_steps": {
                "const": 0
              },
              "chord_source_event_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "chord_remaining_steps": {
                "minimum": 1
              },
              "chord_source_event_id": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "zhen_fengbai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "charge",
        "shield_remaining_steps",
        "shield_source_event_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "charging",
            "shielded"
          ]
        },
        "charge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "shield_remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "shield_source_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "charging"
              }
            }
          },
          "then": {
            "properties": {
              "shield_remaining_steps": {
                "const": 0
              },
              "shield_source_event_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "charge": {
                "const": 0
              },
              "shield_remaining_steps": {
                "minimum": 1
              },
              "shield_source_event_id": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "other_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "class_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "special_resources"
      ],
      "properties": {
        "class_id": {
          "enum": [
            "blade",
            "sword",
            "spear",
            "physician",
            "archer",
            "assassin",
            "musician",
            "fighter",
            "han_feiguan",
            "tan_hualing",
            "mei_liuzhen",
            "lu_fenglang",
            "dongling_shennv",
            "zhen_fengbai"
          ]
        },
        "special_resources": {
          "$ref": "urn:solorxjh:class-special-resources:v1"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/class_constraints"
        }
      ]
    },
    "assassin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combo_points"
      ],
      "properties": {
        "combo_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "han_feiguan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blood_stacks",
        "blood_remaining_steps",
        "blood_source_event_id"
      ],
      "properties": {
        "blood_stacks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "blood_remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "blood_source_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "blood_remaining_steps": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "blood_stacks": {
                "const": 0
              },
              "blood_source_event_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "blood_source_event_id": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "class_constraints": {
      "allOf": [
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "blade"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "sword"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "spear"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "physician"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "archer"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "assassin"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/assassin"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "musician"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/musician"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "fighter"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "han_feiguan"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/han_feiguan"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "tan_hualing"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "mei_liuzhen"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/mei_liuzhen"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "lu_fenglang"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "dongling_shennv"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/other_class"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class_id": {
                "const": "zhen_fengbai"
              }
            }
          },
          "then": {
            "properties": {
              "special_resources": {
                "$ref": "#/$defs/zhen_fengbai"
              }
            }
          }
        }
      ]
    }
  }
}
