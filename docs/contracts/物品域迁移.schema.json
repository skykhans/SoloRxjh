{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:item-custody-transfer:v1",
  "$comment": "不改变物品正文的同角色持有/复购保管域迁移单条投影；完整事件身份、前版本唯一性、正文/来源与钱物原子提交另验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "character_id",
    "kind",
    "target_id",
    "body_revision",
    "previous_custody_receipt_id",
    "from",
    "to"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "stack",
        "instance"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "body_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_custody_receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "from": {
      "$ref": "#/$defs/custody"
    },
    "to": {
      "$ref": "#/$defs/custody"
    }
  },
  "$defs": {
    "custody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "held"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session_id",
            "sale_receipt_id"
          ],
          "properties": {
            "kind": {
              "const": "buyback"
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sale_receipt_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "from": {
          "properties": {
            "kind": {
              "const": "held"
            }
          }
        },
        "to": {
          "properties": {
            "kind": {
              "const": "buyback"
            }
          }
        }
      }
    },
    {
      "properties": {
        "from": {
          "properties": {
            "kind": {
              "const": "buyback"
            }
          }
        },
        "to": {
          "properties": {
            "kind": {
              "const": "held"
            }
          }
        }
      }
    }
  ]
}
