                        "const": "character"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "quest_scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "quest_id",
                          "attempt_id"
                        ],
                        "properties": {
                          "quest_id": {
                            "const": "adv_01"
