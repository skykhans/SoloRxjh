{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:poetry-practice-boost:v1",
  "$comment": "单槽null/原五键任务来源/共享四键配置来源严格互斥；整数token、准确来源字段配置授权、原世界与历史另验，不是完整角色根。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_quest_id",
        "world_id",
        "remaining_world_steps",
        "observed_world_step",
        "grant_receipt_id"
      ],
      "properties": {
        "source_quest_id": {
          "enum": [
            "ref_QREF-63790-037",
            "ref_QREF-63789-037",
            "ref_QREF-63791-022"
          ]
        },
        "world_id": {
          "type": "string",
          "minLength": 1
        },
        "remaining_world_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 432000
        },
        "observed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grant_receipt_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_quest_id": {
                "const": "ref_QREF-63791-022"
              }
            }
          },
          "then": {
            "properties": {
              "remaining_world_steps": {
                "maximum": 324000
              }
            }
          }
        }
      ]
    },
    {
      "$ref": "urn:solorxjh:configured-world-timer-source:v1"
    }
  ]
}
