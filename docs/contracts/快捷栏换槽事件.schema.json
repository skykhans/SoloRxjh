{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:quickbar-binding-event:v1",
  "$comment": "原四技能/三物品栏单槽修改事件；绑定不授予技能或物品。两修订/原槽身份及真实学习/物品使用目录语义另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "bar",
        "slot_index",
        "binding"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bar": {
          "enum": [
            "skill_bar",
            "item_bar"
          ]
        },
        "slot_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "binding": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bar": {
                "const": "skill_bar"
              }
            }
          },
          "then": {
            "properties": {
              "slot_index": {
                "maximum": 3
              },
              "binding": {
                "$ref": "urn:solorxjh:quickbar:v1#/$defs/skill_bar/items"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bar": {
                "const": "item_bar"
              }
            }
          },
          "then": {
            "properties": {
              "slot_index": {
                "maximum": 2
              },
              "binding": {
                "$ref": "urn:solorxjh:quickbar:v1#/$defs/item_bar/items"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "binding_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "binding_before": {
          "anyOf": [
            {
              "$ref": "urn:solorxjh:quickbar:v1#/$defs/skill_bar/items"
            },
            {
              "$ref": "urn:solorxjh:quickbar:v1#/$defs/item_bar/items"
            }
          ]
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:quickbar-binding-event:v1"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "bar": {
                "const": "skill_bar"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "binding_before": {
                "$ref": "urn:solorxjh:quickbar:v1#/$defs/skill_bar/items"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "bar": {
                "const": "item_bar"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "binding_before": {
                "$ref": "urn:solorxjh:quickbar:v1#/$defs/item_bar/items"
              }
            }
          }
        }
      }
    }
  ]
}
