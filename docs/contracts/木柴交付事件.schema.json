{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:firewood-delivery-event:v1",
  "$comment": "寻找木柴15份交付三阶段；15份真实inventory原输入全消费、30000两一次收入、任务完成同笔。原来源/NPC/总量/输入索引与余额算术另验，完整共同保存未闭合不得执行。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "quest_after",
        "stack_flow",
        "silver_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quest_after": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:firewood-quest-state:v1"
            },
            {
              "properties": {
                "phase": {
                  "const": "delivered"
                }
              }
            }
          ]
        },
        "stack_flow": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:stack-flow:v1"
            },
            {
              "properties": {
                "inputs": {
                  "minItems": 1,
                  "maxItems": 15
                },
                "outputs": {
                  "maxItems": 0
                },
                "consumptions": {
                  "minItems": 1,
                  "maxItems": 15,
                  "items": {
                    "properties": {
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15
                      },
                      "reason": {
                        "const": "quest_delivery"
                      }
                    }
                  }
                },
                "mint_authorization": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "silver_flow": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:silver-flow:v1"
            },
            {
              "properties": {
                "accounts": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "account": {
                        "const": "carried_silver"
                      },
                      "before_balance": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254710991
                      },
                      "after_balance": {
                        "type": "integer",
                        "minimum": 30000,
                        "maximum": 9007199254740991
                      },
                      "previous_output": {
                        "type": "object"
                      },
                      "opening_authorization": {
                        "type": "null"
                      }
                    }
                  }
                },
                "movements": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "from_account_index": {
                        "type": "null"
                      },
                      "to_account_index": {
                        "const": 0
                      },
                      "amount": {
                        "const": 30000
                      },
                      "authorization": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "quest_reward"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "quest_before": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:firewood-quest-state:v1"
            },
            {
              "properties": {
                "phase": {
                  "const": "active"
                }
              }
            }
          ]
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "previous_output",
              "stack"
            ],
            "properties": {
              "previous_output": {
                "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
              },
              "stack": {
                "allOf": [
                  {
                    "$ref": "urn:solorxjh:item-stack:v1"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "const": "quest_firewood"
                      },
                      "binding": {
                        "const": "character"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15
                      },
                      "quest_scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "quest_id"
                        ],
                        "properties": {
                          "quest_id": {
                            "const": "ref_QREF-63791-006"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:firewood-delivery-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
