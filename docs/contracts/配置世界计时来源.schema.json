{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:configured-world-timer-source:v1",
  "$comment": "配置授予的单一世界计时源结构。须由原配置决定授权准确角色/字段路径/world/时长/观察步；同形状不能跨来源槽移用凭证，结构本身不授予收益。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "remaining_world_steps",
    "observed_world_step",
    "configuration_receipt_id"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "remaining_world_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_world_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "configuration_receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
