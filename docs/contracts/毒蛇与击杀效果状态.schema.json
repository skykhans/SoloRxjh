{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:venom-kill-effects:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kill_defense_power",
    "full_proc_seal",
    "lu_proc_rage_seal"
  ],
  "properties": {
    "kill_defense_power": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger_event_id",
            "defense_anchor",
            "remaining_steps"
          ],
          "properties": {
            "trigger_event_id": {
              "type": "string",
              "pattern": "\\S"
            },
            "defense_anchor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "remaining_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 900
            }
          }
        }
      ]
    },
    "full_proc_seal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_actor_id",
          "source_ability_id",
          "trigger_event_id",
          "remaining_steps"
        ],
        "properties": {
          "source_actor_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "source_ability_id": {
            "enum": [
              "qigong_blade_e6b3ad595de9",
              "qigong_sword_e6b3ad595de9",
              "qigong_spear_e6b3ad595de9",
              "qigong_fighter_e6b3ad595de9"
            ]
          },
          "trigger_event_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "remaining_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          }
        }
      }
    },
    "lu_proc_rage_seal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_actor_id",
          "trigger_event_id",
          "effective_grade",
          "remaining_steps"
        ],
        "properties": {
          "source_actor_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "trigger_event_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "effective_grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "remaining_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          }
        }
      }
    }
  },
  "$comment": "唯一effects.venom_kill；击杀独立增益/四职业完全封锁/卢降概率禁怒三族，来源唯一与原冻结锚/等级另验。"
}
