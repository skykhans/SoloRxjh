{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:jewelry-override-configuration-event:v1",
  "$comment": "已登记首饰概率/费用稀疏覆盖三阶段原配置事件；只改explicit两组，不授权实例加工等级、钱物或其他字段。完整来源/前后差异与修订算术另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "configuration_revision_after",
        "committed_at_utc"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "configuration_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "committed_at_utc": {
          "$ref": "urn:solorxjh:character-identity:v1#/$defs/utc_seconds"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "session_invalid",
            "source_authority_unavailable",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "expected_character_revision": {
              "maximum": 9007199254740990
            },
            "expected_configuration_revision": {
              "maximum": 9007199254740990
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "before_overrides",
        "before_latest_event_ref"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "before_latest_event_ref": {
          "$ref": "urn:solorxjh:timed-source-configuration-event:v1#/$defs/latest_event_ref"
        },
        "before_overrides": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "ordinary_jewelry_processing": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:ordinary-jewelry-instance:v1#/$defs/processingParameterOverrides"
                }
              ]
            },
            "merit_jewelry_processing": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "urn:solorxjh:ordinary-jewelry-instance:v1#/$defs/processingParameterOverrides"
                }
              ]
            }
          }
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:jewelry-override-configuration-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "expected_configuration_revision",
        "changes"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expected_configuration_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "ordinary_jewelry_processing": {
              "$ref": "urn:solorxjh:ordinary-jewelry-instance:v1#/$defs/processingParameterOverrideChanges"
            },
            "merit_jewelry_processing": {
              "$ref": "urn:solorxjh:ordinary-jewelry-instance:v1#/$defs/processingParameterOverrideChanges"
            }
          },
          "minProperties": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "changes": {
                "required": [
                  "ordinary_jewelry_processing"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "before_overrides": {
                "required": [
                  "ordinary_jewelry_processing"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "plan": {
            "properties": {
              "before_overrides": {
                "not": {
                  "required": [
                    "ordinary_jewelry_processing"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "changes": {
                "required": [
                  "merit_jewelry_processing"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "before_overrides": {
                "required": [
                  "merit_jewelry_processing"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "plan": {
            "properties": {
              "before_overrides": {
                "not": {
                  "required": [
                    "merit_jewelry_processing"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "expected_configuration_revision": {
                "const": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "before_latest_event_ref": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "plan": {
            "properties": {
              "before_latest_event_ref": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
