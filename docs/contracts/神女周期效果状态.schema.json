{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:dongling-periodic-effect-state:v1",
  "$comment": "唯一effects.dongling_periodic的恢复/烧伤来源与各自共享周期；不是完整effects根。原施加/传染/时长修正来源及阶段/技能与参数关系另作语义核验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "healing",
    "burn"
  ],
  "properties": {
    "healing": {
      "$ref": "#/$defs/healing"
    },
    "burn": {
      "$ref": "#/$defs/burn"
    }
  },
  "$defs": {
    "nonblank_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "negative_duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_steps",
        "outgoing_gain_bp",
        "incoming_reduction_bp",
        "effective_total_steps",
        "remaining_steps"
      ],
      "properties": {
        "base_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outgoing_gain_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000,
          "multipleOf": 100
        },
        "incoming_reduction_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000,
          "multipleOf": 100
        },
        "effective_total_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "heal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_actor_id",
        "source_skill_id",
        "root_event_id",
        "stage",
        "caster_rank",
        "remaining_steps"
      ],
      "properties": {
        "source_actor_id": {
          "$ref": "#/$defs/nonblank_id"
        },
        "source_skill_id": {
          "enum": [
            "status_dongling_bfb200cc118e",
            "status_dongling_d2e7d9216918"
          ]
        },
        "root_event_id": {
          "$ref": "#/$defs/nonblank_id"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "caster_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1080
        }
      }
    },
    "burn_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_actor_id",
        "source_skill_id",
        "root_event_id",
        "application_event_id",
        "stage",
        "reward_owner_id",
        "snapshot_attack",
        "timing"
      ],
      "properties": {
        "source_actor_id": {
          "$ref": "#/$defs/nonblank_id"
        },
        "source_skill_id": {
          "enum": [
            "status_dongling_1e3419bec4b8",
            "status_dongling_67324dd0aeab"
          ]
        },
        "root_event_id": {
          "$ref": "#/$defs/nonblank_id"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "reward_owner_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonblank_id"
            }
          ]
        },
        "snapshot_attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timing": {
          "$ref": "#/$defs/negative_duration"
        },
        "application_event_id": {
          "$ref": "#/$defs/nonblank_id"
        }
      }
    },
    "healing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "next_tick_remaining_steps"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/heal_source"
          }
        },
        "next_tick_remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sources": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "next_tick_remaining_steps": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "next_tick_remaining_steps": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "burn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "next_tick_remaining_steps",
        "walked_distance_m"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/burn_source"
          }
        },
        "next_tick_remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "walked_distance_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sources": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "next_tick_remaining_steps": {
                "const": 0
              },
              "walked_distance_m": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "next_tick_remaining_steps": {
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  }
}
