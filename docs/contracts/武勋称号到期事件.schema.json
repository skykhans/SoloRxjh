{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:merit-title-expiry-event:v1",
  "$comment": "原称号实际到期自动续期或不足清除三阶段；非NPC认证或配置，不接受客户端伪造到期。实际时钟/原凭证/余额来源及修订算术另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "committed_world_step",
        "title_state_after",
        "martial_merit_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title_state_after": {
          "$ref": "urn:solorxjh:martial-merit-title-state:v1"
        },
        "martial_merit_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "session_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "expected_character_revision",
        "expected_inventory_revision",
        "due_world_step",
        "origin_receipt_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "due_world_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "origin_receipt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "before_title",
        "martial_merit_before"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "before_title": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:martial-merit-title-state:v1"
            },
            {
              "type": "object",
              "properties": {
                "remaining_steps": {
                  "const": 1
                }
              }
            }
          ]
        },
        "martial_merit_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:merit-title-expiry-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "before_title": {
                "properties": {
                  "stage": {
                    "const": 8
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "plan": {
              "properties": {
                "martial_merit_before": {
                  "minimum": 50000
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "title_state_after": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": 8
                },
                "remaining_steps": {
                  "const": 155520000
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "title_state_after": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "before_title": {
                "properties": {
                  "stage": {
                    "const": 9
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "plan": {
              "properties": {
                "martial_merit_before": {
                  "minimum": 150000
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "title_state_after": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": 9
                },
                "remaining_steps": {
                  "const": 155520000
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "title_state_after": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
