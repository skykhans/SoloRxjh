{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ordinary-monster-death-identity:v1",
  "$comment": "公共普通刷点真实战斗死亡的原身份及致死引用；不是完整死亡/奖励事务，不用于修炼召唤/私场/脚本移除。真实普通刷点白名单、代次/actor及致死源须联合认证。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "spawn_id",
    "generation",
    "target_actor_id",
    "lethal_damage_event_id",
    "observed_world_step",
    "rules_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 79,
      "maxLength": 79,
      "pattern": "^ordinary-death:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:character-location:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "type": "null"
    },
    "spawn_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "target_actor_id": {
      "$ref": "urn:solorxjh:ordinary-monster-life-identity:v1#/properties/actor_id"
    },
    "lethal_damage_event_id": {
      "$ref": "urn:solorxjh:combat-damage-identity:v1#/$defs/event_id"
    },
    "observed_world_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rules_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
