{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:portable-travel-admission-event:v1",
  "$comment": "原便携读条接纳三阶段；plan为原唯一九键计划读条，committed才写入角色。预留不开始读条、不消费物品或启动冷却。资格/前态空闲/原来源/同一身份及修订联合验证，非读条完成或取消事件。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "state_changed",
            "session_invalid"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "action_kind",
        "authorization",
        "destination_point_or_null"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action_kind": {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/channel/properties/action_kind"
        },
        "authorization": {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/channel/properties/authorization"
        },
        "destination_point_or_null": {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/channel/properties/destination_point_or_null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "portable_return"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "allOf": [
                  {
                    "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/item_authorization"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "enum": [
                          "return_talisman",
                          "return_liuzheng",
                          "return_sanxie",
                          "return_shenwu",
                          "return_liushan",
                          "return_beihai"
                        ]
                      }
                    }
                  }
                ]
              },
              "destination_point_or_null": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "earth_spirit_travel"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "allOf": [
                  {
                    "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/item_authorization"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "enum": [
                          "earth_spirit_talisman"
                        ]
                      }
                    }
                  }
                ]
              },
              "destination_point_or_null": {
                "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/point_reference"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_kind": {
                "const": "supreme_talisman_travel"
              }
            }
          },
          "then": {
            "properties": {
              "authorization": {
                "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/supreme_authorization"
              },
              "destination_point_or_null": {
                "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/point_reference"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/channel"
        },
        {
          "properties": {
            "remaining_steps": {
              "const": 180
            },
            "channel_id": {
              "$ref": "urn:solorxjh:allocated-settlement-identity:v1#/properties/settlement_id"
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:portable-travel-admission-event:v1#"
      }
    }
  }
}
