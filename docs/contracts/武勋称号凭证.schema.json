{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:martial-merit-title-state:v1",
  "$comment": "character.martial_merit_title_state仅null或原三键凭证；余额/路线/有效资格、真实认证续期配置来源及原时钟另验。零剩余应在原到期事务裁决，不能读档自动清除。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "remaining_steps",
        "origin_receipt_id"
      ],
      "properties": {
        "stage": {
          "enum": [
            8,
            9
          ]
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 155520000
        },
        "origin_receipt_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  ],
  "$defs": {
    "certification_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "requested_stage",
        "service_opening_index"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requested_stage": {
          "enum": [
            8,
            9
          ]
        },
        "service_opening_index": {
          "$ref": "urn:solorxjh:warehouse-silver-event:v1#/$defs/service_context/properties/opening_index"
        }
      }
    }
  }
}
