        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "record"
          ],
          "properties": {
            "owner": {
              "const": "urn:solorxjh:support-cast-effect:v1"
            },
            "record": {
              "$ref": "urn:solorxjh:support-cast-effect:v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "record"
          ],
          "properties": {
            "owner": {
              "const": "urn:solorxjh:dongling-support-cast-admission:v1"
            },
            "record": {
              "$ref": "urn:solorxjh:dongling-support-cast-admission:v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "record"
          ],
          "properties": {
            "owner": {
              "const": "urn:solorxjh:dongling-direct-attack-admission:v1"
            },
            "record": {
              "allOf": [
                {
                  "$ref": "urn:solorxjh:dongling-direct-attack-admission:v1"
                },
                {
                  "properties": {
                    "source_actor_id": {
                      "$ref": "urn:solorxjh:player-on-foot-motion-result:v1#/properties/source_actor_id"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "result_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "sequence",
        "previous_result_id",
        "result_id",
        "rules_hash",
        "producer",
        "character_revision_before",
        "inventory_revision_before",
        "character_revision_after",
        "inventory_revision_after",
        "character_before_digest",
        "character_after_digest",
        "character_after_base64",
        "required_profile_world_step_or_null"
      ],
      "properties": {
        "play_session_identity": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
            },
            {
              "properties": {
                "mode": {
                  "enum": [
                    "lan_host",
                    "lan_client"
                  ]
                }
              }
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previous_result_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "result_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "producer": {
          "$ref": "#/$defs/result_producer"
        },
        "character_revision_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_revision_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "character_before_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "character_after_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "character_after_base64": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/opening_character_base64"
        },
        "required_profile_world_step_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        }
      },
      "$comment": "完整传输/重放封套结构，原业务正文与本地保存水位分开。Base64必须解码全量角色并先验完整根/来源，快照业务摘要仅剔除network_receipts；完整角色根未采用前不能应用此封套。",
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previous_result_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_result_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required_profile_world_step_or_null": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "producer": {
                "properties": {
                  "owner": {
                    "const": "urn:solorxjh:character-session:v1#/$defs/end_receipt"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "result_journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/result_envelope"
      },
      "$comment": "同world/profile/character完整连续链，数组位置i对应sequence=i+1，跨session不重置；当前未采用压缩，不允许裁前缀。"
    },
    "client_result_proofs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "additionalProperties": {
          "$ref": "#/$defs/result_journal"
        }
      },
      "$comment": "profile.lan_result_proofs[world_id][character_id]，只属于本profile接收角色；host自己的结果在原world日志，不再复制此表。原远端producer不是本档通用结算分配，不计settlement_next_id。"
    }
  }
}
