{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:network-receipts:v1",
  "$comment": "character.network_receipts原world_id映射及从已保存head派生的累计ACK。只验证结构，不是完整角色/结果封套或成员认证；连续链/真实保存/原结果相等须owner语义校验。",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "minLength": 1,
    "pattern": "\\S"
  },
  "additionalProperties": {
    "$ref": "#/$defs/head"
  },
  "$defs": {
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_profile_id",
        "last_applied_sequence",
        "last_result_id",
        "last_result_character_revision",
        "last_result_inventory_revision",
        "saved_profile_revision"
      ],
      "properties": {
        "authority_profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_applied_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_result_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "last_result_character_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "last_result_inventory_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "saved_profile_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "last_applied_sequence": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "last_result_id": {
                "type": "null"
              },
              "last_result_character_revision": {
                "type": "null"
              },
              "last_result_inventory_revision": {
                "type": "null"
              },
              "saved_profile_revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "last_result_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "last_result_character_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "last_result_inventory_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "saved_profile_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      ]
    },
    "saved_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "authority_profile_id",
        "profile_id",
        "character_id",
        "result_id",
        "applied_sequence",
        "character_revision",
        "inventory_revision",
        "saved_profile_revision"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority_profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "character_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "result_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "applied_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "saved_profile_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "result_producer": {
      "$comment": "仅已采用严格原记录的owner白名单；reserved不构成结果。未登记原producer拒绝，不能用任意object或kind字符串授权；合法记录结构不替代完整源依赖及共同决定验证。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "record"
          ],
          "properties": {
