  "pair_formula": {
    "inputs": "same own-class learned allocated effectiveJingjin J and Xueqi B, each0..40, unknown source rejected",
    "attack_add_both_endpoints": "floor(5*J*(10000-100*B)/10000)",
    "gangqi_add": "floor(5*B*(10000-100*J)/10000)",
    "dampening": "uses opposing effective grade, not already dampened contribution; one pass no feedback/iteration",
    "scope": "only paired own contributions reduced, never reduce all attack or item gangqi by these percentages",
    "grade0": "contribution0, no suppression from absent passive; no permanent allocation reset"
  },
  "music_extra": {
    "gangqi_per_effective_grade": 3,
    "not_reduced_by_paired_attack_skill": true,
    "source_class": "musician only, base independent flat gangqi source"
  },
  "gangqi_stat": {
    "type": "nonnegative exact integer rating",
    "initial_explicit_base": 0,
    "not_resource": true,
    "consumed_on_damage": false,
    "sums": "base0 + actual adopted activeequipment sources + own pair source + named other flat sources; inactive gear/group never double counted",
    "local_role": "independent direct martial damage resistance; not ordinarydefense/PvEdefense or percent datum, source exact role not publicly proven by these lines",
    "mitigation": "floor(after ordinary/context defense incoming*100/(100+current gangqi)), root direct attack_martial_skill only",
    "basic_environment_periodic": "not protected by this stat unless separate explicit profile declares it",
    "stage": "after ordinary/context defense, before flat damage reductions/armor extra/finalextra and named percent shields; no second ordinarydefense calculation",
    "rating0": "no extra resistance",
    "final_override": "explicit configured final gangqi replaces computedrating, no duplicate cache",
    "out_of_range": "negative/overflow/unknown contribution rejects config, never default0"
  },
  "snapshot_policy": "live effective J/B recompute property source on grade/equipment change; accepted action attack interval stays original paid snapshot, next action uses recomputed attack. Defensive gangqi read at target damage settlement, not persisted as a stale duplicate.",
  "persistence": "save allocations/explicit equipment/valid covers only, computed pair/extra/rating recalculated. No HP/mana restoration, no new item or weapon advancement from either passive. Grade anti effects expire by own world steps.",
  "runtime_boundary": "beforeformalactivation every armor source and final override schema must be defined. The29binding design does not close all high gear definitions or prove playable late-game balance."
}
