{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:combat-resolution-batch:v1",
  "$comment": "原world当前scope固定步伤害批次，严格七字段；只保存真实尚未完成的队列项，不另存sorted IDs/next index/已完成标志。scope在批次唯一，四字段项与批次重建原七键。冻结全集、排序/取消证明和父world阶段另验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "world_step",
    "phase",
    "pending_items"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:character-location:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "world_step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "enum": [
        "ordinary",
        "corpse_wave"
      ]
    },
    "pending_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_or_root_event_id",
        "target_id",
        "hit_or_tick_ordinal",
        "corpse_sort_source_or_null"
      ],
      "properties": {
        "action_or_root_event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "hit_or_tick_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "corpse_sort_source_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "original_death_root_id",
                "winning_source_id"
              ],
              "properties": {
                "original_death_root_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "winning_source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ordinary"
          }
        }
      },
      "then": {
        "properties": {
          "pending_items": {
            "items": {
              "properties": {
                "corpse_sort_source_or_null": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "pending_items": {
            "items": {
              "properties": {
                "corpse_sort_source_or_null": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    {
      "$ref": "urn:solorxjh:world-step-state:v1#/$defs/instance_binding"
    }
  ]
}
