{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:heavenly-stone-conversion-event:v1",
  "$comment": "本人背包选定单堆天机石N转同数未分配升天攻击点的唯一三阶段事件；实际石来源/资格/算术与C预算授权另验，不含领取/任务交付/初始化退款。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "stack_flows",
        "ascension_unallocated_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "urn:solorxjh:stack-flow:v1",
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "outputs": {
                "maxItems": 1,
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "const": "heavenly_stone"
                        },
                        "binding": {
                          "const": "character"
                        },
                        "quest_scope": {
                          "type": "null"
                        },
                        "quantity": {
                          "maximum": 9998
                        },
                        "revision": {
                          "minimum": 1
                        }
                      }
                    },
                    "contributions": {
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "properties": {
                          "input_index": {
                            "const": 0
                          },
                          "quantity": {
                            "maximum": 9998
                          }
                        }
                      }
                    },
                    "custody": {
                      "properties": {
                        "kind": {
                          "const": "held"
                        }
                      }
                    }
                  }
                }
              },
              "consumptions": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "input_index": {
                      "const": 0
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9999
                    },
                    "reason": {
                      "const": "use"
                    }
                  }
                }
              },
              "mint_authorization": {
                "type": "null"
              }
            }
          }
        },
        "ascension_unallocated_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "state_changed",
            "rules_changed",
            "session_invalid",
            "explicit_cancel"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "stack_id",
        "quantity"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "stack_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "stack_input"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "stack_input": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "$ref": "urn:solorxjh:heavenly-stone-conversion-event:v1"
      }
    }
  }
}
