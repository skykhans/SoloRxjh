{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:third-advancement-upper-transition-event:v1",
  "$comment": "上半段原推荐书接取/放弃三阶段；recommendation是锁定证据不作为清理flow输入。本轮正确材料最多10，放弃唯一quest_cleanup；第六错杀失败及两阶段交付另属原owner，完整来源/修订/角色共同父另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "urn:solorxjh:firewood-task-transition-event:v1#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "quest_after",
        "stack_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "urn:solorxjh:firewood-task-transition-event:v1#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quest_after": {
          "$ref": "urn:solorxjh:third-advancement-upper-quest-state:v1"
        },
        "stack_flow": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cleanup_flow"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "urn:solorxjh:firewood-task-transition-event:v1#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs",
        "branch_id",
        "recommendation"
      ],
      "properties": {
        "rules_hash": {
          "$ref": "urn:solorxjh:third-advancement-lower-transition-event:v1#/$defs/plan/properties/rules_hash"
        },
        "quest_before": {
          "$ref": "urn:solorxjh:third-advancement-upper-quest-state:v1"
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/material_input"
          }
        },
        "branch_id": {
          "enum": [
            "righteous",
            "evil"
          ]
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation_input"
        }
      }
    },
    "material_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_output",
        "stack"
      ],
      "properties": {
        "previous_output": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        },
        "stack": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:item-stack:v1"
            },
            {
              "properties": {
                "item_id": {
                  "enum": [
                    "adv03_righteous_upper_good",
                    "adv03_evil_upper_good"
                  ]
                },
                "binding": {
                  "const": "character"
                },
                "quest_scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quest_id",
                    "attempt_id",
                    "branch_id"
                  ],
                  "properties": {
                    "quest_id": {
                      "const": "adv_03_upper"
                    },
                    "attempt_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "branch_id": {
                      "enum": [
                        "righteous",
                        "evil"
                      ]
                    }
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            }
          ]
        }
      }
    },
    "recommendation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_output",
        "stack"
      ],
      "properties": {
        "previous_output": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        },
        "stack": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:item-stack:v1"
            },
            {
              "properties": {
                "item_id": {
                  "enum": [
                    "adv03_righteous_recommendation",
                    "adv03_evil_recommendation"
                  ]
                },
                "binding": {
                  "const": "character"
                },
                "quest_scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "quest_id",
                    "completion_receipt_id"
                  ],
                  "properties": {
                    "quest_id": {
                      "enum": [
                        "ref_QREF-63790-018",
                        "ref_QREF-63789-018"
                      ]
                    },
                    "completion_receipt_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          ]
        }
      }
    },
    "cleanup_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 10
            },
            "outputs": {
              "maxItems": 0
            },
            "consumptions": {
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "reason": {
                    "const": "quest_cleanup"
                  }
                }
              }
            },
            "mint_authorization": {
              "type": "null"
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:third-advancement-upper-transition-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "operation": {
                "const": "accept"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "quest_before": {
                "properties": {
                  "state": {
                    "const": "not_accepted"
                  }
                }
              },
              "inputs": {
                "maxItems": 0
              }
            }
          },
          "quest_after": {
            "properties": {
              "state": {
                "const": "in_progress"
              },
              "stage_index_or_null": {
                "const": 1
              },
              "violation_count_or_null": {
                "const": 0
              },
              "stage_receipts": {
                "maxItems": 0
              }
            }
          },
          "stack_flow": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "plan": {
            "properties": {
              "quest_before": {
                "properties": {
                  "state": {
                    "const": "in_progress"
                  }
                }
              }
            }
          },
          "quest_after": {
            "properties": {
              "state": {
                "const": "not_accepted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "inputs": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stack_flow": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "stack_flow": {
            "type": "object"
          },
          "command": {
            "properties": {
              "expected_inventory_revision": {
                "maximum": 9007199254740990
              }
            }
          },
          "inventory_revision_after": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "quest_before": {
                "properties": {
                  "stage_index_or_null": {
                    "const": 2
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "inputs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "branch_id": {
                "const": "righteous"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "inputs": {
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "const": "adv03_righteous_upper_good"
                        },
                        "quest_scope": {
                          "properties": {
                            "branch_id": {
                              "const": "righteous"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "recommendation": {
                "properties": {
                  "stack": {
                    "properties": {
                      "item_id": {
                        "const": "adv03_righteous_recommendation"
                      },
                      "quest_scope": {
                        "properties": {
                          "quest_id": {
                            "const": "ref_QREF-63790-018"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "branch_id": {
                "const": "evil"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "inputs": {
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "const": "adv03_evil_upper_good"
                        },
                        "quest_scope": {
                          "properties": {
                            "branch_id": {
                              "const": "evil"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "recommendation": {
                "properties": {
                  "stack": {
                    "properties": {
                      "item_id": {
                        "const": "adv03_evil_recommendation"
                      },
                      "quest_scope": {
                        "properties": {
                          "quest_id": {
                            "const": "ref_QREF-63789-018"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
