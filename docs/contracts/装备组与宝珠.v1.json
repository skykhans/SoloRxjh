          "label": "项链",
          "nullable_empty": true
        },
        {
          "id": "earring_a",
          "label": "耳环一",
          "nullable_empty": true
        },
        {
          "id": "earring_b",
          "label": "耳环二",
          "nullable_empty": true
        },
        {
          "id": "ring_a",
          "label": "戒指一",
          "nullable_empty": true
        },
        {
          "id": "ring_b",
          "label": "戒指二",
          "nullable_empty": true
        },
        {
