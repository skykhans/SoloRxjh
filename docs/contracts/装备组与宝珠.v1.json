{
  "contract_id": "local_equipment_gems_v1",
  "version": 1,
  "date": "2026-11-13",
  "status": "planned_specific_project_rules_pending_overall_D1_audit",
  "runtime_implemented": false,
  "engine_target": "Godot 4.7.2 standard / GDScript",
  "authority_note": "本文件是项目采用方案，不是官网原值表或用户逐值确认；项目值显式列出，程序不得把未知源值兜底成这些数。",
