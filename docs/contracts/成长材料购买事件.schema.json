{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:growth-material-purchase-event:v1",
  "$comment": "仅两种明确成长材料的严格NPC购买三阶段事件。数量/费率乘积、原槽合堆/来源/新ID/修订和容量语义另验；不授权其他材料或真实服务。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "stack_flows",
        "silver_flow"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "silver_flow": {
          "$ref": "#/$defs/silver_flow"
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/mint_flow"
            },
            {
              "$ref": "#/$defs/merge_flow"
            }
          ],
          "items": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id",
        "item_id",
        "quantity"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "item_id": {
          "enum": [
            "heat_blood_synthesis_stone",
            "enhancement_stone"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "unit_price",
        "inventory_before",
        "merge_inputs"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "unit_price": {
          "enum": [
            500,
            10000
          ]
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "merge_inputs": {
          "type": "array",
          "maxItems": 99,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/merge_input"
          }
        }
      }
    },
    "material_stack": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:item-stack:v1"
        },
        {
          "properties": {
            "item_id": {
              "enum": [
                "heat_blood_synthesis_stone",
                "enhancement_stone"
              ]
            },
            "binding": {
              "const": "character"
            },
            "quest_scope": {
              "type": "null"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        }
      ]
    },
    "merge_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_output",
        "stack"
      ],
      "properties": {
        "previous_output": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        },
        "stack": {
          "allOf": [
            {
              "$ref": "#/$defs/material_stack"
            },
            {
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 98
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740990
                }
              }
            }
          ]
        }
      }
    },
    "mint_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "maxItems": 0
            },
            "consumptions": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "allOf": [
                  {
                    "properties": {
                      "stack": {
                        "$ref": "#/$defs/material_stack"
                      },
                      "custody": {
                        "const": {
                          "kind": "held"
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "stack": {
                        "properties": {
                          "revision": {
                            "const": 0
                          }
                        }
                      },
                      "contributions": {
                        "maxItems": 0
                      }
                    }
                  }
                ]
              }
            },
            "mint_authorization": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "npc_purchase"
                }
              }
            }
          }
        }
      ]
    },
    "merge_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "minItems": 2,
              "maxItems": 100
            },
            "consumptions": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 99,
              "items": {
                "properties": {
                  "stack": {
                    "$ref": "#/$defs/material_stack"
                  },
                  "custody": {
                    "const": {
                      "kind": "held"
                    }
                  }
                }
              }
            },
            "mint_authorization": {
              "type": "null"
            }
          }
        }
      ]
    },
    "silver_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:silver-flow:v1"
        },
        {
          "properties": {
            "accounts": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "account": {
                    "const": "carried_silver"
                  },
                  "previous_output": {
                    "type": "object"
                  },
                  "opening_authorization": {
                    "type": "null"
                  }
                }
              }
            },
            "movements": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "from_account_index": {
                    "const": 0
                  },
                  "to_account_index": {
                    "type": "null"
                  },
                  "authorization": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "npc_purchase"
                      }
                    }
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 500,
                    "maximum": 990000
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:growth-material-purchase-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "merge_inputs": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stack_flows": {
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "stack_flows": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "item_id": {
                "const": "heat_blood_synthesis_stone"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "unit_price": {
                "const": 10000
              },
              "merge_inputs": {
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "const": "heat_blood_synthesis_stone"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "heat_blood_synthesis_stone"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "silver_flow": {
            "properties": {
              "movements": {
                "items": {
                  "properties": {
                    "amount": {
                      "minimum": 10000,
                      "maximum": 990000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "item_id": {
                "const": "enhancement_stone"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "unit_price": {
                "const": 500
              },
              "merge_inputs": {
                "items": {
                  "properties": {
                    "stack": {
                      "properties": {
                        "item_id": {
                          "const": "enhancement_stone"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "enhancement_stone"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "silver_flow": {
            "properties": {
              "movements": {
                "items": {
                  "properties": {
                    "amount": {
                      "minimum": 500,
                      "maximum": 49500
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
