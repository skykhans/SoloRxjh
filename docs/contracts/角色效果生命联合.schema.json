{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:character-effects-life-projection:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "life_state",
    "timers",
    "effects"
  ],
  "properties": {
    "life_state": {
      "$ref": "urn:solorxjh:character-life-state:v1#/properties/life_state"
    },
    "timers": {
      "$ref": "urn:solorxjh:character-cooldown-timers:v1"
    },
    "effects": {
      "$ref": "urn:solorxjh:character-effects:v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "life_state": {
            "const": "awaiting_respawn"
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "$ref": "urn:solorxjh:character-effects:v1#/$defs/cleared"
          }
        }
      }
    }
  ],
  "$comment": "仅原字段校验投影不保存；另运行既有神女及防护投影，完整角色先校验白名单。"
}
