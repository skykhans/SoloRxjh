{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:rage-effect-sources:v1",
  "$comment": "唯一character.effects.rage_sources组件，不是完整effects根。目标为持有本组件的实体；来源同施加者/能力/profile唯一，原事件真实性及实际生效时长另作语义核验。自然怒气840为600+6*40静态上界，不证明任一角色均有40级延时。",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "source_actor_id",
          "source_ability_id",
          "root_event_id",
          "remaining_steps"
        ],
        "properties": {
          "profile_id": {
            "const": "natural"
          },
          "source_actor_id": {
            "$ref": "#/$defs/nonblank_id"
          },
          "source_ability_id": {
            "type": "null"
          },
          "root_event_id": {
            "$ref": "#/$defs/nonblank_id"
          },
          "remaining_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 840
          }
        }
      },
