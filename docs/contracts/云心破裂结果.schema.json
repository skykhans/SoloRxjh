{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:cloud-shield-break:v1",
  "$comment": "云心真实破裂原伤害事务子结果，严格12字段。罚血前HP0必须原死亡引用且实际罚血0；存活者实际正损失且无prior death。真正破池/冻结上限/ceil与cap/终态死亡及作用域另验，不是活跃盾状态或独立日志。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "world_id",
    "authority_profile_id",
    "map_id",
    "instance_id_or_null",
    "target_actor_id",
    "shield_instance_id",
    "breaking_damage_event_id",
    "activation_max_hp",
    "hp_before_penalty",
    "actual_hp_loss",
    "prior_death_event_id_or_null"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 76,
      "maxLength": 76,
      "pattern": "^cloud-break:[0-9a-f]{64}(?![\\s\\S])"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "map_id": {
      "$ref": "urn:solorxjh:character-location:v1#/properties/map_id"
    },
    "instance_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "target_actor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "shield_instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "breaking_damage_event_id": {
      "$ref": "urn:solorxjh:combat-damage-identity:v1#/$defs/event_id"
    },
    "activation_max_hp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hp_before_penalty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actual_hp_loss": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prior_death_event_id_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "hp_before_penalty": {
          "const": 0
        },
        "actual_hp_loss": {
          "const": 0
        },
        "prior_death_event_id_or_null": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    {
      "properties": {
        "hp_before_penalty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actual_hp_loss": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "prior_death_event_id_or_null": {
          "type": "null"
        }
      }
    }
  ],
  "allOf": [
    {
      "$ref": "urn:solorxjh:world-step-state:v1#/$defs/instance_binding"
    }
  ]
}
