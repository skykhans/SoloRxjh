{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:random-state:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "seed_hex",
    "next_block"
  ],
  "properties": {
    "algorithm": {
      "const": "sha256_counter_53_v1"
    },
    "seed_hex": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "next_block": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
