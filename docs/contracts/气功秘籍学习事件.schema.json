          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "learned_record": {
          "$ref": "urn:solorxjh:qigong-manual-records:v1#/items",
          "properties": {
            "consumption_ref": {
              "properties": {
                "flow_index": {
                  "const": 0
                },
                "consumption_index": {
                  "const": 0
                }
              }
            }
          }
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "urn:solorxjh:stack-flow:v1",
            "properties": {
              "inputs": {
                "minItems": 1,
                "maxItems": 1
              },
              "outputs": {
                "maxItems": 1
              },
              "consumptions": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "input_index": {
                      "const": 0
                    },
                    "quantity": {
                      "const": 1
                    },
                    "reason": {
                      "const": "use"
                    }
                  }
                }
              },
              "mint_authorization": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
