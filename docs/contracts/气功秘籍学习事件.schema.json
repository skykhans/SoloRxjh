{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:qigong-manual-event:v1",
  "$comment": "读一本气功秘籍的唯一原owner三阶段日志。真实资格/输入来源/修订算术/请求身份与状态迁移另验，非完整档案或网络结果封套。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
