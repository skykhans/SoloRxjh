{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:ordinary-item-pickup-event:v1",
  "$comment": "五种普通物品F拾取三阶段事件；真实权利/距离/归属/容量、来源与版本等式、共同角色/world提交按原owner另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "stack_flows"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stack_flows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/mint_flow"
            },
            {
              "$ref": "#/$defs/merge_flow"
            }
          ],
          "items": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "plan": {
                "properties": {
                  "merge_input_or_null": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "stack_flows": {
                "maxItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "stack_flows": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "source_unavailable",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "$ref": "urn:solorxjh:bamboo-pickup-event:v1#/$defs/command"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "world_step",
        "drop_before",
        "inventory_before",
        "merge_input_or_null"
      ],
      "properties": {
        "rules_hash": {
          "$ref": "urn:solorxjh:player-gather-action:v1#/properties/rules_hash"
        },
        "world_step": {
          "$ref": "urn:solorxjh:player-on-foot-motion-result:v1#/properties/world_step"
        },
        "drop_before": {
          "$ref": "urn:solorxjh:ordinary-item-scene-drop:v1"
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "merge_input_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/merge_input"
            }
          ]
        }
      }
    },
    "merge_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_output",
        "stack"
      ],
      "properties": {
        "previous_output": {
          "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
        },
        "stack": {
          "allOf": [
            {
              "$ref": "#/$defs/ordinary_stack"
            },
            {
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 98
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740990
                }
              }
            }
          ]
        }
      }
    },
    "mint_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "maxItems": 0
            },
            "consumptions": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "allOf": [
                  {
                    "properties": {
                      "stack": {
                        "$ref": "#/$defs/ordinary_stack"
                      },
                      "custody": {
                        "const": {
                          "kind": "held"
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "stack": {
                        "properties": {
                          "revision": {
                            "const": 0
                          },
                          "quantity": {
                            "const": 1
                          }
                        }
                      },
                      "contributions": {
                        "maxItems": 0
                      }
                    }
                  }
                ]
              }
            },
            "mint_authorization": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "loot"
                }
              }
            }
          }
        }
      ]
    },
    "merge_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "minItems": 2,
              "maxItems": 2
            },
            "consumptions": {
              "maxItems": 0
            },
            "outputs": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "properties": {
                  "stack": {
                    "$ref": "#/$defs/ordinary_stack"
                  },
                  "custody": {
                    "const": {
                      "kind": "held"
                    }
                  }
                }
              }
            },
            "mint_authorization": {
              "type": "null"
            }
          }
        }
      ]
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:ordinary-item-pickup-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "ordinary_stack": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:item-stack:v1"
        },
        {
          "properties": {
            "item_id": {
              "$ref": "urn:solorxjh:ordinary-item-scene-drop:v1#/properties/item_id"
            },
            "binding": {
              "const": "character"
            },
            "quest_scope": {
              "type": "null"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "drop_before": {
                "properties": {
                  "item_id": {
                    "const": "beast_hide"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "merge_input_or_null": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/merge_input"
                      },
                      {
                        "properties": {
                          "stack": {
                            "properties": {
                              "item_id": {
                                "const": "beast_hide"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "beast_hide"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "drop_before": {
                "properties": {
                  "item_id": {
                    "const": "wolf_fang"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "merge_input_or_null": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/merge_input"
                      },
                      {
                        "properties": {
                          "stack": {
                            "properties": {
                              "item_id": {
                                "const": "wolf_fang"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "wolf_fang"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "drop_before": {
                "properties": {
                  "item_id": {
                    "const": "spirit_ore"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "merge_input_or_null": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/merge_input"
                      },
                      {
                        "properties": {
                          "stack": {
                            "properties": {
                              "item_id": {
                                "const": "spirit_ore"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "spirit_ore"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "drop_before": {
                "properties": {
                  "item_id": {
                    "const": "bear_paw"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "merge_input_or_null": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/merge_input"
                      },
                      {
                        "properties": {
                          "stack": {
                            "properties": {
                              "item_id": {
                                "const": "bear_paw"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "bear_paw"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "properties": {
              "drop_before": {
                "properties": {
                  "item_id": {
                    "const": "bear_gall"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "merge_input_or_null": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/merge_input"
                      },
                      {
                        "properties": {
                          "stack": {
                            "properties": {
                              "item_id": {
                                "const": "bear_gall"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "stack_flows": {
            "items": {
              "properties": {
                "outputs": {
                  "items": {
                    "properties": {
                      "stack": {
                        "properties": {
                          "item_id": {
                            "const": "bear_gall"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
