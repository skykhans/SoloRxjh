{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:third-advancement-upper-stage-event:v1",
  "$comment": "三转上半段两阶段交付。原来源真实性、同一attempt/原推荐书、数量守恒、修订相等、经验算术、成长气功历史及完整共同父必须另行语义校验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "quest_after",
        "stack_flow",
        "progress_after",
        "qigong_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quest_after": {
          "$ref": "urn:solorxjh:third-advancement-upper-quest-state:v1"
        },
        "stack_flow": {
          "$ref": "#/$defs/consume_flow"
        },
        "progress_after": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:character-progress:v1"
            },
            {
              "properties": {
                "completed_rank": {
                  "const": 2
                },
                "hp": {
                  "minimum": 1
                },
                "total_xp": {
                  "minimum": 156841000
                }
              }
            }
          ]
        },
        "qigong_after": {
          "$ref": "urn:solorxjh:qigong-state:v1"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
