            {
              "properties": {
                "completed_rank": {
                  "const": 2
                },
                "hp": {
                  "minimum": 1
                },
                "total_xp": {
                  "minimum": 156841000
                }
              }
            }
          ]
        },
        "qigong_before": {
          "$ref": "urn:solorxjh:qigong-state:v1"
        },
        "experience_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/experience"
            }
          ]
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_award",
        "credited",
        "discarded"
