        },
        "confirmed_experience_cap_loss": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs",
        "branch_id",
        "recommendation",
        "progress_before",
        "qigong_before",
        "experience_or_null"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "quest_before": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:third-advancement-upper-quest-state:v1"
            },
            {
              "properties": {
                "state": {
                  "const": "in_progress"
                }
              }
            }
          ]
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "urn:solorxjh:third-advancement-upper-transition-event:v1#/$defs/material_input"
              },
              {
                "$ref": "urn:solorxjh:third-advancement-upper-transition-event:v1#/$defs/recommendation_input"
              }
            ]
          }
        },
        "branch_id": {
          "enum": [
            "righteous",
            "evil"
          ]
        },
        "recommendation": {
          "$ref": "urn:solorxjh:third-advancement-upper-transition-event:v1#/$defs/recommendation_input"
        },
