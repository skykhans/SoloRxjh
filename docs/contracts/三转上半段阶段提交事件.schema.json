  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "interaction_id",
        "confirmed_experience_cap_loss"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:firewood-delivery-event:v1#/$defs/command/properties/play_session_identity"
        },
        "command_id": {
          "$ref": "urn:solorxjh:firewood-delivery-event:v1#/$defs/command/properties/command_id"
        },
        "expected_character_revision": {
          "$ref": "urn:solorxjh:firewood-delivery-event:v1#/$defs/command/properties/expected_character_revision",
