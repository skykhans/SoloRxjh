        "credited": {
          "type": "integer",
          "minimum": 0,
          "maximum": 350000
        },
        "discarded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 350000
        }
      }
    },
    "consume_flow": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:stack-flow:v1"
        },
        {
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true
            },
            "outputs": {
              "maxItems": 0
