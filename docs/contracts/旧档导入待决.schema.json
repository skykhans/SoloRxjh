{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:legacy-import-pending:v1",
  "$comment": "profile.legacy_import_pending显式null或六键原导入预留种子。原字节/规范Base64/规则哈希/固定候选重建/角色与档案闭合必须另验，不能凭摘要运行未知完整角色。",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlement_identity",
        "source_base64",
        "rules_hash",
        "candidate_receipt_digest",
        "created_at_utc",
        "reservation_profile_revision"
      ],
      "properties": {
        "settlement_identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "source_base64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        },
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "candidate_receipt_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "created_at_utc": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        "reservation_profile_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740990
        }
      }
    }
  ]
}
