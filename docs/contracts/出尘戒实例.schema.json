{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:chuchen-ring-instance:v1",
  "$comment": "出尘戒独立不可变七字段完整实例；精确身份、资格、配置创建和死亡终结来源另验，不是完整档案。严格revision整数token0，拒绝1.0或指数等非整数token。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "item_id",
    "lineage_id",
    "owner_character_id",
    "binding",
    "revision",
    "creation_receipt_id"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "item_id": {
      "const": "jewelry_death_ring_5164091a0f5f"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner_character_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "binding": {
      "const": "character"
    },
    "revision": {
      "type": "integer",
      "const": 0
    },
    "creation_receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
