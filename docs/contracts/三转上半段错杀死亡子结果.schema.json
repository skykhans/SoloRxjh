                "enum": [
                  2,
                  null
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quest_before": {
            "properties": {
              "stage_index_or_null": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "quest_after": {
            "properties": {
              "stage_index_or_null": {
                "enum": [
                  1,
                  null
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
