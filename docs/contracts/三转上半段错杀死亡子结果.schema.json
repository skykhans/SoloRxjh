      "if": {
        "properties": {
          "quest_before": {
            "properties": {
              "violation_count_or_null": {
                "const": 2
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "violation_count_after": {
            "const": 3
          },
          "cleanup_inputs": {
            "maxItems": 0
          },
          "cleanup_flow_or_null": {
            "type": "null"
          },
          "failure_receipt_id_or_null": {
            "type": "null"
          },
          "quest_after": {
            "properties": {
              "state": {
                "const": "in_progress"
              },
              "violation_count_or_null": {
                "const": 3
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quest_before": {
            "properties": {
              "violation_count_or_null": {
                "const": 3
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "violation_count_after": {
            "const": 4
          },
          "cleanup_inputs": {
            "maxItems": 0
          },
          "cleanup_flow_or_null": {
            "type": "null"
          },
          "failure_receipt_id_or_null": {
            "type": "null"
          },
          "quest_after": {
            "properties": {
              "state": {
                "const": "in_progress"
              },
              "violation_count_or_null": {
                "const": 4
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quest_before": {
            "properties": {
              "violation_count_or_null": {
                "const": 4
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "violation_count_after": {
            "const": 5
          },
          "cleanup_inputs": {
            "maxItems": 0
          },
          "cleanup_flow_or_null": {
            "type": "null"
          },
          "failure_receipt_id_or_null": {
            "type": "null"
          },
          "quest_after": {
            "properties": {
              "state": {
                "const": "in_progress"
              },
              "violation_count_or_null": {
                "const": 5
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quest_before": {
            "properties": {
              "violation_count_or_null": {
                "const": 5
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "violation_count_after": {
            "const": 6
          },
          "quest_after": {
            "properties": {
