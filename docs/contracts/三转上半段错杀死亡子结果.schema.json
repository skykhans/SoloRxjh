                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "branch_id": {
            "const": "evil"
          }
        }
      },
      "then": {
        "properties": {
          "recommendation": {
            "properties": {
              "stack": {
                "properties": {
                  "item_id": {
                    "const": "adv03_evil_recommendation"
                  },
                  "quest_scope": {
                    "properties": {
                      "quest_id": {
                        "const": "ref_QREF-63789-018"
