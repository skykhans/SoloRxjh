      "then": {
        "properties": {
          "recommendation": {
            "properties": {
              "stack": {
                "properties": {
                  "item_id": {
                    "const": "adv03_righteous_recommendation"
                  },
                  "quest_scope": {
                    "properties": {
                      "quest_id": {
                        "const": "ref_QREF-63790-018"
                      }
                    }
                  }
                }
              }
            }
          },
          "cleanup_inputs": {
            "items": {
              "properties": {
                "stack": {
                  "properties": {
