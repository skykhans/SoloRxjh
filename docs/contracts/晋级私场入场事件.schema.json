{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:private-trial-entry-event:v1",
  "$comment": "六转影子/武勋试练原入场三阶段事件；严格命令五键/计划三键，三身份由原结算派生而不重复存。实际world活动节点/资格/构筑及修订同笔另验，未闭合不得运行。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "committed_world_step",
        "migration_result"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_world_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "migration_result": {
          "$ref": "#/$defs/migration_result"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "interaction_invalid",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "service_id"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "service_id": {
          "enum": [
            "npc_yuegong_henge_merit_trial",
            "npc_yuegong_henge_adv06"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "arena_id",
        "main_attempt_id_or_null"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "arena_id": {
          "enum": [
            "faction_merit_trial",
            "ascension_shadow_trial"
          ]
        },
        "main_attempt_id_or_null": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:private-trial-entry-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    },
    "migration_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_before",
        "location_after"
      ],
      "properties": {
        "location_before": {
          "$ref": "urn:solorxjh:character-location:v1",
          "properties": {
            "map_id": {
              "const": "nanlin_forest"
            }
          }
        },
        "location_after": {
          "$ref": "urn:solorxjh:character-location:v1",
          "properties": {
            "map_id": {
              "enum": [
                "instance_faction_merit",
                "instance_ascension_shadow"
              ]
            },
            "position": {
              "const": [
                0,
                0,
                -12
              ]
            },
            "yaw": {
              "const": 3.141592653589793
            }
          }
        }
      },
      "$comment": "仅实际迁移前后姿态，所属world/authority/角色由原command，目标instance由原入场identity确定派生，实际T沿外层committed_world_step；不复制第二角色after。实际源scope/角色步消费与可落地来源另验。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "service_id": {
                "const": "npc_yuegong_henge_merit_trial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "arena_id": {
                "const": "faction_merit_trial"
              },
              "main_attempt_id_or_null": {
                "type": "null"
              }
            }
          },
          "migration_result": {
            "properties": {
              "location_after": {
                "properties": {
                  "map_id": {
                    "const": "instance_faction_merit"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "service_id": {
                "const": "npc_yuegong_henge_adv06"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "properties": {
              "arena_id": {
                "const": "ascension_shadow_trial"
              },
              "main_attempt_id_or_null": {
                "type": "string"
              }
            }
          },
          "migration_result": {
            "properties": {
              "location_after": {
                "properties": {
                  "map_id": {
                    "const": "instance_ascension_shadow"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
