{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:accepted-attack-timing:v1",
  "$comment": "已接受直接攻击原动作的五字段联合投影；不新增timing包装。冻结时序与唯一已完成步游标；原定义授权、总和安全、偏移严格递增/小于active及游标<=总时长另验。不是完整动作、命中结果或队列。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "windup_steps",
    "active_steps",
    "recovery_steps",
    "hit_offsets_in_active_steps",
    "elapsed_steps"
  ],
  "properties": {
    "windup_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recovery_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "elapsed_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hit_offsets_in_active_steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740990
      }
    }
  }
}
