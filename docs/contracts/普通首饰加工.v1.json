  "field_policy": {
    "fields": [
      "processing_level",
      "processing_origin_receipt_id"
    ],
    "processing_level": "严格整数0～definition.processing_level_limit且上限10，拒绝bool/float/string或小数/指数token，不用enhancement。",
    "processing_origin_receipt_id": "新建0级显式null且须正式创建来源；任何已提交加工后为非空字符串，指向同角色/同实例血统的最近加工成功或失败收据。收据输入等级/材料/栏位/概率分支/结果等级与前链一致。失败降0可非空，不把级别0等同没历史。 明确配置来源另按instance_schema_owner_ref核验，不伪造正常尝试；后续加工保配置前缀。",
    "fresh": "只正式新建路径写0/null；旧档缺失拒绝，不能按本模板修复。完整单实例九字段按68；完整档案/库存/收据日志schema仍待。",
    "preservation": "同定义/实例/血统/绑定及其余合法状态保留，仅两加工字段按结果改变；任何未知成长/损坏来源或未采用非空状态先拒绝，不清字段让输入通过。"
  },
  "distribution_policy": {
    "table_selector": "精确静态定义资格minimum_level==170且minimum_completed_rank==12取level170_rank12_jewelry，其余71目录成员取ordinary_jewelry；不按操作者等级170/当前转职改变低阶首饰权重。坏定义或未知身份拒绝。",
    "random_order": "先完整校验、锁修订及费用可付；应用68所选角色同修订有效参数，整体概率0必失败/10000必成功均不抽，否则一次0～9999比较。失败不抽跨阶；成功仅当本行有两个及以上不同结果时再抽条件结果，否则不抽。条件区间按target_level升序，历史保存有效参数快照，不按后来覆盖重判。",
    "cap": "项目明确成功超过上限的档位归10且不额外补偿。表已合并相同目标：8级普通池9/10为80/20，170池85/15；9级只到10且无条件随机。不是修复非法输入，输入10已拒绝，非法11不截回10。",
    "material_and_fee": "已提交尝试不论成功失败消费本栏符1及本行手续费；取消/过期/坏输入/不够费拒绝前不耗/不抽。首饰任何失败不销毁。无其他隐含材料、幸运符或概率补偿。"
  },
