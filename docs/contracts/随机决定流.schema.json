{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:random-decision-flow:v1",
  "$comment": "原已提交事件内随机决定流；流只保身份/算法/seed/有序draws，每次draw独占[next_block_before,next_block_after)含拒绝块的消费区间。父/子结果可同流穿插而不重复记账；整笔真实调用顺序/完整区间覆盖与来源另验，确定结果不造draw。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "streams"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_kind",
        "owner_id",
        "algorithm",
        "seed_hex",
        "draws"
      ],
      "properties": {
        "owner_kind": {
          "enum": [
            "character",
            "world"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "algorithm": {
          "$ref": "urn:solorxjh:random-state:v1#/properties/algorithm"
        },
        "seed_hex": {
          "$ref": "urn:solorxjh:random-state:v1#/properties/seed_hex"
        },
        "draws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/draw"
          }
        }
      }
    },
    "draw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "low",
        "high",
        "result",
        "next_block_before",
        "next_block_after"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "low": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "high": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "result": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "next_block_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "next_block_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        }
      }
    }
  }
}
