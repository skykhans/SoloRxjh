{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:random-decision-flow:v1",
  "$comment": "原已提交事件内随机决定流，不是新独立抽奖事件/重复日志；授权用途/排序/seed历史/连续计数和拒绝抽样重算另验。确定结果不伪造抽数记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "streams"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_kind",
        "owner_id",
        "algorithm",
        "seed_hex",
        "next_block_before",
        "next_block_after",
        "draws"
      ],
      "properties": {
        "owner_kind": {
          "enum": [
            "character",
            "world"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "algorithm": {
          "$ref": "urn:solorxjh:random-state:v1#/properties/algorithm"
        },
        "seed_hex": {
          "$ref": "urn:solorxjh:random-state:v1#/properties/seed_hex"
        },
        "next_block_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "next_block_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "draws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/draw"
          }
        }
      }
    },
    "draw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "low",
        "high",
        "result",
        "next_block_after"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "low": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "high": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "result": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "next_block_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
