{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:private-trial-enemy-state:v1",
  "$comment": "六转两具名敌唯一五键运行状态。规则包/原模板构筑装备由父活动原rules_hash认证，动作全文/派生与world随机流沿父队列；非完整活动节点。NPC不伪造玩家life_state/pending_death。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "location",
    "hp",
    "effects",
    "behavior"
  ],
  "properties": {
    "actor_id": {
      "$ref": "urn:solorxjh:private-advancement-trial-reference:v1#/$defs/enemy_actor_id"
    },
    "location": {
      "$ref": "urn:solorxjh:character-location:v1"
    },
    "hp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effects": {
      "$ref": "urn:solorxjh:character-effects:v1",
      "properties": {
        "blood_devil_challenge": {
          "type": "null"
        }
      }
    },
    "behavior": {
      "$ref": "urn:solorxjh:private-trial-enemy-behavior:v1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "behavior": {
            "properties": {
              "definition_id": {
                "const": "project_faction_merit_veteran100"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "properties": {
              "map_id": {
                "const": "instance_faction_merit"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "behavior": {
            "properties": {
              "definition_id": {
                "const": "project_yuegong_shadow115"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "properties": {
              "map_id": {
                "const": "instance_ascension_shadow"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hp": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "effects": {
            "$ref": "urn:solorxjh:character-effects:v1#/$defs/cleared"
          },
          "behavior": {
            "properties": {
              "ai_state": {
                "const": "stopped"
              },
              "accepted_action_id_or_null": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
