{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:world-step-begin-clock-result:v1",
  "$comment": "原world begin共同父内七键时钟/初始scope/逐档案服务及到期逐角色结果投影，不是完整父或独立日志。到期结果七键引用真实角色/库存版本及原来源，全集/精确身份/修订/重量和共同保存须联合验证。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_id",
    "authority_profile_id",
    "rules_hash",
    "world_before",
    "world_after",
    "supreme_clock_results",
    "supreme_expiry_role_results"
  ],
  "properties": {
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rules_hash": {
      "$ref": "urn:solorxjh:supreme-service-clock-result:v1#/properties/rules_hash"
    },
    "world_before": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:world-step-state:v1"
        },
        {
          "properties": {
            "training_gate_clock_steps": {
              "maximum": 9007199254740990
            },
            "step_pending_scopes": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "world_after": {
      "allOf": [
        {
          "$ref": "urn:solorxjh:world-step-state:v1"
        },
        {
          "properties": {
            "training_gate_clock_steps": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "supreme_clock_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:solorxjh:supreme-service-clock-result:v1"
      }
    },
    "supreme_expiry_role_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expiry_role_result"
      }
    }
  },
  "$defs": {
    "expiry_role_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "character_id",
        "character_revision_before",
        "character_revision_after",
        "inventory_revision",
        "knight_bag_overweight_after",
        "cancelled_portable_channel_id_or_null"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "character_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "character_revision_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knight_bag_overweight_after": {
          "$ref": "urn:solorxjh:knight-bag-overweight:v1"
        },
        "cancelled_portable_channel_id_or_null": {
          "$ref": "urn:solorxjh:portable-travel-channel:v1#/$defs/cancelled_portable_channel_id_or_null"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "knight_bag_overweight_after": {
                    "type": "object"
                  }
                }
              },
              {
                "properties": {
                  "cancelled_portable_channel_id_or_null": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "character_revision_before": {
                "maximum": 9007199254740990
              },
              "character_revision_after": {
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supreme_clock_results": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "service_before"
                ],
                "properties": {
                  "service_before": {
                    "type": "object",
                    "required": [
                      "remaining_steps"
                    ],
                    "properties": {
                      "remaining_steps": {
                        "const": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "supreme_expiry_role_results": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
