  "$defs": {
    "command": {
      "$ref": "urn:solorxjh:firewood-task-transition-event:v1#/$defs/command"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "quest_before",
        "inventory_before",
        "inputs"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "quest_before": {
          "$ref": "urn:solorxjh:first-advancement-quest-state:v1"
        },
        "inventory_before": {
          "$ref": "urn:solorxjh:item-locations:v1#/properties/inventory"
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "previous_output",
              "stack"
            ],
            "properties": {
              "previous_output": {
                "$ref": "urn:solorxjh:stack-flow:v1#/properties/inputs/items"
              },
              "stack": {
                "allOf": [
                  {
                    "$ref": "urn:solorxjh:item-stack:v1"
                  },
                  {
                    "properties": {
                      "item_id": {
                        "enum": [
                          "adv01_boar_leg",
                          "adv01_boar_bbq",
                          "adv01_guard_armor",
                          "adv01_wolf_bone",
                          "adv01_smith_medicine",
                          "adv01_guard_sword"
                        ]
                      },
                      "binding": {
                        "const": "character"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "quest_scope": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "quest_id",
                          "attempt_id"
                        ],
                        "properties": {
                          "quest_id": {
                            "const": "adv_01"
                          },
                          "attempt_id": {
                            "$ref": "urn:solorxjh:item-stack:v1#/$defs/questScope/properties/attempt_id"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:first-advancement-transition-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
