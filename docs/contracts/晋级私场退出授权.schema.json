{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:private-trial-exit-authorization:v1",
  "$comment": "六转私场实际授权退出的四字段原决定子结果；非独立通用预留/日志。保完整命令作为血魔与私场终局结束来源，无反向终局/死亡引用。真实active/存活/距离/权限及提交认证另验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "command",
    "world_step",
    "rules_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 83,
      "maxLength": 83,
      "pattern": "^private-trial-exit:[0-9a-f]{64}(?![\\s\\S])"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_session_identity",
        "command_id",
        "expected_character_revision",
        "expected_inventory_revision",
        "trial_attempt_id",
        "interaction_id",
        "abandon_main_quest"
      ],
      "properties": {
        "play_session_identity": {
          "$ref": "urn:solorxjh:character-session:v1#/$defs/identity"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_character_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "expected_inventory_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trial_attempt_id": {
          "$ref": "urn:solorxjh:private-advancement-trial-reference:v1#/$defs/trial_attempt_id"
        },
        "interaction_id": {
          "enum": [
            "private_trial_exit_marker",
            "private_trial_abandon_panel"
          ]
        },
        "abandon_main_quest": {
          "type": "boolean"
        }
      }
    },
    "world_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rules_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "interaction_id": {
                "const": "private_trial_exit_marker"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "abandon_main_quest": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
