{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:merit-title-certification-event:v1",
  "$comment": "原称号首次8/9认证与8升9三阶段；非配置/付费续期/到期事件。严格来源、实际NPC会话、时钟差与修订算术另验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan"
      ],
      "properties": {
        "phase": {
          "const": "reserved"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "character_revision_after",
        "inventory_revision_after",
        "committed_world_step",
        "title_state_after"
      ],
      "properties": {
        "phase": {
          "const": "committed"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "character_revision_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_revision_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title_state_after": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:martial-merit-title-state:v1"
            },
            {
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "identity",
        "command",
        "plan",
        "reason"
      ],
      "properties": {
        "phase": {
          "const": "aborted"
        },
        "identity": {
          "$ref": "urn:solorxjh:allocated-settlement-identity:v1"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "reason": {
          "enum": [
            "user_cancelled",
            "session_invalid",
            "source_authority_unavailable",
            "state_changed"
          ]
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "$ref": "urn:solorxjh:martial-merit-title-state:v1#/$defs/certification_request"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_hash",
        "before_title",
        "martial_merit_before",
        "observed_world_step"
      ],
      "properties": {
        "rules_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "before_title": {
          "allOf": [
            {
              "$ref": "urn:solorxjh:martial-merit-title-state:v1"
            },
            {
              "if": {
                "type": "object"
              },
              "then": {
                "properties": {
                  "stage": {
                    "const": 8
                  }
                }
              }
            }
          ]
        },
        "martial_merit_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "journal": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "urn:solorxjh:merit-title-certification-event:v1"
      },
      "contains": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "const": "reserved"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "requested_stage": {
                "const": 8
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "title_state_after": {
            "properties": {
              "stage": {
                "const": 8
              }
            }
          },
          "plan": {
            "properties": {
              "martial_merit_before": {
                "minimum": 1500000
              },
              "before_title": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": {
              "requested_stage": {
                "const": 9
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "title_state_after": {
            "properties": {
              "stage": {
                "const": 9
              }
            }
          },
          "plan": {
            "properties": {
              "martial_merit_before": {
                "minimum": 5000000
              }
            }
          }
        }
      }
    }
  ]
}
