{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:training-gate-buffs:v1",
  "$comment": "character.training_gate_buffs；仅保存原主题账本。原世界时钟、周期/余时可达性、授予收据和配置事务由原owner联合校验；外世界不可激活，无载入补领。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "by_world"
  ],
  "properties": {
    "by_world": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/world"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_claimed_cycle_or_null",
        "remaining_world_steps"
      ],
      "properties": {
        "last_claimed_cycle_or_null": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 6949999424
        },
        "remaining_world_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 432000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "last_claimed_cycle_or_null": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "remaining_world_steps": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_world_step",
        "themes"
      ],
      "properties": {
        "observed_world_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "themes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "beihai",
            "nanlin",
            "dongling",
            "huxia"
          ],
          "properties": {
            "beihai": {
              "$ref": "#/$defs/theme"
            },
            "nanlin": {
              "$ref": "#/$defs/theme"
            },
            "dongling": {
              "$ref": "#/$defs/theme"
            },
            "huxia": {
              "$ref": "#/$defs/theme"
            }
          }
        }
      }
    }
  }
}
