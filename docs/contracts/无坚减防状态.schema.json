{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solorxjh:half-defense-state:v1",
  "$comment": "持有实体隐含为接收者；仅原来源与正余时，来源唯一/原触发/职业/扣时链另语义核验。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_actor_id",
      "trigger_event_id",
      "remaining_steps",
      "reduction_bp"
    ],
    "properties": {
      "source_actor_id": {
        "type": "string",
        "pattern": "\\S"
      },
      "trigger_event_id": {
        "type": "string",
        "pattern": "\\S"
      },
      "remaining_steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 180
      },
      "reduction_bp": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 7000,
        "multipleOf": 50
      }
    }
  }
}
